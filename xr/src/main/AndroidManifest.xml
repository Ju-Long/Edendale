<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <!-- Installed with the app only on devices that declare the spatial XR
         feature; fused into a universal APK, where the player still offers
         the theater only on such a device. -->
    <dist:module
        dist:instant="false"
        dist:title="@string/xr_module_title">
        <dist:delivery>
            <dist:install-time>
                <dist:conditions>
                    <dist:device-feature dist:name="android.software.xr.api.spatial" />
                </dist:conditions>
            </dist:install-time>
        </dist:delivery>
        <dist:fusing dist:include="true" />
    </dist:module>

    <application>
        <activity
            android:name=".theater.XrTheaterActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <!-- The theater opens straight into Full Space; the rest of the app stays a panel. -->
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED" />
        </activity>
    </application>
</manifest>
