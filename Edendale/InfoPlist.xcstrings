    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale verbindet sich mit den von dir verknüpften Medienservern (wie SMB-Freigaben), um deine eigenen Videodateien zu durchsuchen und abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale connects to the media servers you link (such as SMB shares) to browse and play your own video files."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale connects to the media servers you link (such as SMB shares) to browse and play your own video files."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale connects to the media servers you link (such as SMB shares) to browse and play your own video files."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale connects to the media servers you link (such as SMB shares) to browse and play your own video files."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale connects to the media servers you link (such as SMB shares) to browse and play your own video files."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale se conecta a los servidores multimedia que vincules (como recursos compartidos SMB) para explorar y reproducir tus propios archivos de vídeo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale se conecta a los servidores multimedia que vincules (como recursos compartidos SMB) para explorar y reproducir tus propios archivos de video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale se connecte aux serveurs multimédias que vous associez (tels que les partages SMB) pour parcourir et lire vos propres fichiers vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale si connette ai server multimediali che colleghi (come le condivisioni SMB) per sfogliare e riprodurre i tuoi file video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendaleは、自分のビデオファイルをブラウズして再生するため、リンクしたメディアサーバー（SMB共有など）に接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale은 사용자가 연결한 미디어 서버(SMB 공유 등)에 접속하여 사용자의 비디오 파일을 탐색하고 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale maakt verbinding met de mediaservers die je koppelt (zoals SMB-shares) om door je eigen videobestanden te bladeren en deze af te spelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Edendale se conecta aos servidores de mídia que você vincular (como compartilhamentos SMB) para explorar e reproduzir seus próprios arquivos de vídeo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Edendale liga-se aos servidores multimédia que associar (como partilhas SMB) para explorar e reproduzir os seus próprios ficheiros de vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale подключается к добавленным медиасерверам (например, SMB-ресурсам), чтобы просматривать и воспроизводить ваши видеофайлы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale ansluter till mediaservrarna du länkar (som SMB-delningar) för att bläddra bland och spela upp dina egna videofiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale 连接到您关联的媒体服务器（如 SMB 共享）以浏览和播放您自己的视频文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale 會連線至你連結的媒體伺服器（例如 SMB 共享），以瀏覽並播放你自己的影片檔案。"
          }
        }
      }
    },
