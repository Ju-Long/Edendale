.build/

# Python release tooling
__pycache__/
*.py[cod]

# Local credentials live in .secret/ — Secrets.xcconfig (TMDB/Wyzie keys) and the
# App Store Connect AuthKey_*.p8. Never commit anything from it.
/.secret/

# Safety net for stray credential copies outside .secret/
Secrets.xcconfig
Secrets.xcconfig.tmp.*
/secrets.json
/secrets.json.tmp.*

# Apple release credentials and signing material
AuthKey_*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.keychain-db
/Sample Movie

