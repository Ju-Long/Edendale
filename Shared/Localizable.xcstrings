        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスを取り消すと、リンクしたApple TVからもサインアウトされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근 권한을 취소하면 연결한 모든 Apple TV에서도 로그아웃됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de toegang intrekt, word je ook uitgelogd op elke Apple TV waaraan je deze hebt gekoppeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revogar o acesso também finaliza a sessão em qualquer Apple TV que você tenha vinculado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revogar o acesso também termina a sessão em qualquer Apple TV a que o tenha ligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При отзыве доступа также выполняется выход на всех Apple TV, к которым вы его подключили."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
