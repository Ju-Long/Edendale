          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede establecer conexión con %@. Comprueba que el servidor está encendido, en la misma red y que el nombre o las credenciales son correctos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a %@. Revisa que el servidor esté encendido, en la misma red y que el nombre o las credenciales sean correctos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %@. Vérifiez que le serveur est allumé, sur le même réseau et que le nom ou les identifiants sont corrects."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %@. Verifica che il server sia acceso, sulla stessa rete e che il nome o le credenziali siano corretti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にアクセスできません。サーバーが起動し、同じネットワーク上にあり、名前または認証情報が正しいことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결할 수 없습니다. 서버가 켜져 있고 같은 네트워크에 있는지, 이름이나 자격 증명이 올바른지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %@ niet bereiken. Controleer of de server aanstaat, in hetzelfde netwerk zit en of de naam of inloggegevens kloppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível alcançar %@. Verifique se o servidor está ligado, na mesma rede, e se o nome ou as credenciais estão corretos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível aceder a %@. Verifique se o servidor está ligado, na mesma rede e se o nome ou as credenciais estão corretos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается подключиться к %@. Убедитесь, что сервер включен, находится в той же сети, а его имя и учетные данные верны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte nå %@. Kontrollera att servern är på, i samma nätverk, och att namnet eller inloggningsuppgifterna stämmer."
