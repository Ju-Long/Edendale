          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your thumb on the right edge of the clickpad to play at %@, or on the left edge to play at %@. Playback returns to its usual speed when you lift it."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your thumb on the right edge of the clickpad to play at %@, or on the left edge to play at %@. Playback returns to its usual speed when you lift it."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya el pulgar en el borde derecho del clickpad para reproducir a %1$@, o en el borde izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al levantarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya el pulgar en el borde derecho del clickpad para reproducir a %1$@, o en el borde izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al levantarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez le pouce sur le bord droit du pavé tactile pour lire à %1$@, ou sur le bord gauche pour lire à %2$@. La lecture reprend sa vitesse habituelle lorsque vous le levez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appoggia il pollice sul bordo destro del clickpad per riprodurre a %1$@, o sul bordo sinistro per riprodurre a %2$@. La riproduzione torna alla velocità abituale quando lo sollevi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックパッドの右端に親指を置くと%1$@、左端に置くと%2$@で再生します。指を離すと通常の速度に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭패드의 오른쪽 가장자리에 엄지를 올려 두면 %1$@, 왼쪽 가장자리에 올려 두면 %2$@ 속도로 재생됩니다. 손을 떼면 원래 속도로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je duim op de rechterrand van de clickpad rusten om af te spelen op %1$@, of op de linkerrand om af te spelen op %2$@. Het afspelen keert terug naar de gebruikelijke snelheid als je hem optilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie o polegar na borda direita do clickpad para reproduzir a %1$@, ou na borda esquerda para reproduzir a %2$@. A reprodução volta à velocidade normal quando você levanta o dedo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouse o polegar na margem direita do clickpad para reproduzir a %1$@, ou na margem esquerda para reproduzir a %2$@. A reprodução volta à velocidade habitual quando levantar o dedo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите большой палец на правый край кликпада, чтобы воспроизводить со скоростью %1$@, или на левый край — со скоростью %2$@. Когда вы уберете палец, скорость вернется к обычной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vila tummen på klickplattans högra kant för att spela upp i %1$@, eller på den vänstra kanten för att spela upp i %2$@. Uppspelningen återgår till sin vanliga hastighet när du lyfter den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将拇指放在触控板右边缘可以 %1$@ 播放，放在左边缘可以 %2$@ 播放。抬起拇指后恢复正常速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將拇指放在觸控板右邊緣可以 %1$@ 播放，放在左邊緣可以 %2$@ 播放。抬起拇指後會恢復一般速度。"
          }
        }
      }
    },
