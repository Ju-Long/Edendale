        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un cuadrado para iniciar una selección. Los cuadrados más brillantes contienen más estrenos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un cuadro para iniciar una selección. Los cuadros más brillantes contienen más estrenos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un carré pour commencer une sélection. Les carrés plus clairs contiennent plus de sorties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un riquadro per iniziare una selezione. I riquadri più luminosi contengono più uscite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスをタップして選択を開始します。明るいマスほど公開作品の数が多くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사각형을 탭하여 선택을 시작하십시오. 사각형이 밝을수록 공개된 작품이 더 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een vierkant om een selectie te starten. Lichtere vierkanten bevatten meer releases."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um quadrado para iniciar uma seleção. Quadrados mais brilhantes contêm mais lançamentos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
