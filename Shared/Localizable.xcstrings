    "E-AC-3 surround tracks play through the system’s decoder without enhancement, keeping their full surround and spatial audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3-Surround-Spuren werden ohne Verbesserung über den Systemdecoder wiedergegeben und behalten ihren vollen Surround-Klang und 3D-Audio."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 surround tracks play through the system’s decoder without enhancement, keeping their full surround and spatial audio."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 surround tracks play through the system’s decoder without enhancement, keeping their full surround and spatial audio."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 surround tracks play through the system’s decoder without enhancement, keeping their full surround and spatial audio."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 surround tracks play through the system’s decoder without enhancement, keeping their full surround and spatial audio."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pistas envolventes E-AC-3 se reproducen con el decodificador del sistema sin mejora y conservan todo su sonido envolvente y su audio espacial."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pistas envolventes E-AC-3 se reproducen con el decodificador del sistema sin mejora y conservan todo su sonido envolvente y su audio espacial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pistes surround E-AC-3 sont lues par le décodeur du système sans amélioration et conservent tout leur son surround et leur audio spatial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tracce surround E-AC-3 vengono riprodotte dal decodificatore di sistema senza miglioramento e mantengono tutto il loro audio surround e spaziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3サラウンドトラックは補正なしでシステムのデコーダで再生され、サラウンドと空間オーディオがそのまま保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 서라운드 트랙은 향상 없이 시스템 디코더를 통해 재생되어 서라운드 및 공간 음향이 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3-surroundtracks worden zonder verbetering afgespeeld via de decoder van het systeem en behouden hun volledige surroundgeluid en ruimtelijke audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As faixas surround E-AC-3 são reproduzidas pelo decodificador do sistema sem aprimoramento, mantendo todo o som surround e o Áudio Espacial."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As faixas surround E-AC-3 são reproduzidas pelo descodificador do sistema sem melhoria, mantendo todo o som surround e o áudio espacial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объемные дорожки E-AC-3 воспроизводятся системным декодером без улучшения, сохраняя полный объемный и пространственный звук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3-surroundspår spelas upp via systemets avkodare utan förbättring och behåller sitt fulla surroundljud och rumsliga ljud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 环绕声音轨通过系统解码器播放，不进行增强，保留完整的环绕声和空间音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-AC-3 環繞音軌會透過系統解碼器播放，不進行增強，保留完整的環繞音效和空間音訊。"
          }
        }
      }
    },
