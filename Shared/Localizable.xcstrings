    "Couldn't connect to the other device. Make sure it's nearby, unlocked, and on the same network, with Edendale open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Verbindung zum anderen Gerät möglich. Achte darauf, dass es sich in der Nähe befindet, entsperrt und im selben Netzwerk ist und Edendale geöffnet hat."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the other device. Make sure it's nearby, unlocked, and on the same network, with Edendale open."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the other device. Make sure it's nearby, unlocked, and on the same network, with Edendale open."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the other device. Make sure it's nearby, unlocked, and on the same network, with Edendale open."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the other device. Make sure it's nearby, unlocked, and on the same network, with Edendale open."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido conectar con el otro dispositivo. Asegúrate de que esté cerca, desbloqueado y en la misma red, con Edendale abierto."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el otro dispositivo. Asegúrate de que esté cerca, desbloqueado y en la misma red, con Edendale abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter à l’autre appareil. Assurez-vous qu’il est à proximité, déverrouillé et sur le même réseau, avec Edendale ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi all’altro dispositivo. Assicurati che sia vicino, sbloccato e sulla stessa rete, con Edendale aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスに接続できませんでした。そのデバイスが近くにあり、ロックが解除され、同じネットワークに接続されていて、Edendaleが開いていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 연결할 수 없습니다. 기기가 근처에 있고 잠금 해제되어 있으며 같은 네트워크에 연결되어 있고 Edendale이 열려 있는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan geen verbinding maken met het andere apparaat. Zorg dat het in de buurt is, ontgrendeld en op hetzelfde netwerk, met Edendale geopend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao outro dispositivo. Verifique se ele está por perto, desbloqueado e na mesma rede, com o Edendale aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ligar ao outro dispositivo. Certifique-se de que está por perto, desbloqueado e na mesma rede, com o Edendale aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к другому устройству. Убедитесь, что оно рядом, разблокировано, подключено к той же сети и на нем открыто приложение Edendale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att ansluta till den andra enheten. Se till att den är i närheten, upplåst och på samma nätverk, med Edendale öppet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到其他设备。请确保该设备在附近、已解锁、连接到同一网络，并且已打开 Edendale。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至其他裝置。請確定該裝置在附近、已解鎖、連接相同的網路，並且已打開 Edendale。"
          }
        }
      }
    },
    "Couldn't mount the NFS export on %@: %@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die NFS-Freigabe auf %1$@ konnte nicht eingebunden werden: %2$@. Apple-Geräte verbinden sich von einem nicht privilegierten Port aus, daher benötigt die Freigabe die Option „insecure“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't mount the NFS export on %1$@: %2$@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't mount the NFS export on %1$@: %2$@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't mount the NFS export on %1$@: %2$@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't mount the NFS export on %1$@: %2$@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't mount the NFS export on %1$@: %2$@. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido montar la exportación NFS en %1$@: %2$@. Los dispositivos Apple se conectan desde un puerto sin privilegios, así que la exportación necesita la opción «insecure»."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo montar la exportación NFS en %1$@: %2$@. Los dispositivos Apple se conectan desde un puerto sin privilegios, así que la exportación necesita la opción “insecure”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de monter l’export NFS sur %1$@ : %2$@. Les appareils Apple se connectent depuis un port non privilégié, l’export doit donc avoir l’option « insecure »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile montare l’export NFS su %1$@: %2$@. I dispositivi Apple si connettono da una porta non privilegiata, quindi l’export richiede l’opzione “insecure”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のNFSエクスポートをマウントできませんでした: %2$@。Appleデバイスは非特権ポートから接続するため、エクスポートには“insecure”オプションが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 NFS 내보내기를 마운트할 수 없습니다: %2$@. Apple 기기는 비특권 포트에서 연결하므로 내보내기에 “insecure” 옵션이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de NFS-export op %1$@ niet koppelen: %2$@. Apple-apparaten maken verbinding vanaf een niet-geprivilegieerde poort, dus de export heeft de optie “insecure” nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível montar a exportação NFS em %1$@: %2$@. Os dispositivos Apple se conectam a partir de uma porta sem privilégios, então a exportação precisa da opção “insecure”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível montar a exportação NFS em %1$@: %2$@. Os dispositivos Apple ligam-se a partir de uma porta sem privilégios, por isso a exportação precisa da opção “insecure”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось смонтировать NFS-экспорт на %1$@: %2$@. Устройства Apple подключаются с непривилегированного порта, поэтому для экспорта нужен параметр «insecure»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att montera NFS-exporten på %1$@: %2$@. Apple-enheter ansluter från en oprivilegierad port, så exporten behöver alternativet ”insecure”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在 %1$@ 上装载 NFS 导出：%2$@。Apple 设备从非特权端口连接，因此该导出需要“insecure”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法在 %1$@ 上掛載 NFS 匯出：%2$@。Apple 裝置會從非特權埠連線，因此該匯出需要「insecure」選項。"
