    "“%@” is removed from your library. Nothing in %@ is deleted, and your account stays linked in Settings → Accounts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wird aus deiner Mediathek entfernt. In %2$@ wird nichts gelöscht, und dein Account bleibt unter Einstellungen → Accounts verknüpft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is removed from your library. Nothing in %2$@ is deleted, and your account stays linked in Settings → Accounts."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
