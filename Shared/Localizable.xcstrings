          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el clickpad o desliza hacia arriba para ver los controles. Pulsa Atrás para volver a ocultarlos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona el clickpad o desliza hacia arriba para ver los controles. Presiona Atrás para volver a ocultarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le pavé tactile ou balayez vers le haut pour afficher les commandes. Appuyez sur Retour pour les masquer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi il clickpad o scorri verso l’alto per mostrare i controlli. Premi Indietro per nasconderli di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックパッドを押すか上にスワイプすると、コントロールが表示されます。「戻る」を押すと再び隠れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭패드를 누르거나 위로 쓸어올리면 제어기가 나타납니다. 다시 가리려면 뒤로 버튼을 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op de clickpad of veeg omhoog om de regelaars te tonen. Druk op Terug om ze weer te verbergen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no clickpad ou deslize para cima para mostrar os controles. Pressione Voltar para ocultá-los novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima o clickpad ou passe o dedo para cima para mostrar os controlos. Prima Voltar para os ocultar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кликпад или смахните вверх, чтобы показать элементы управления. Нажмите «Назад», чтобы снова скрыть их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på klickplattan eller svep uppåt för att visa reglagen. Tryck på Bakåt för att dölja dem igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下触控板或向上轻扫即可显示控制。按下“返回”可再次隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下觸控板或向上滑動即可顯示控制項目。按下「返回」可再次隱藏。"
          }
        }
      }
    },
    "Click the video once to show or hide the controls. They fade away on their own after five seconds of playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke einmal auf das Video, um die Steuerung ein- oder auszublenden. Nach fünf Sekunden Wiedergabe blendet sie sich von selbst aus."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
