    "Show buttons to skip intros, recaps, and credits when community timestamps are available. Playback continues until you choose to skip." : {
      "comment" : "A description of the feature that allows users to skip ads during playback.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten zum Überspringen von Intros, Rückblicken und Abspann anzeigen, wenn Zeitmarken der Community verfügbar sind. Die Wiedergabe läuft weiter, bis du dich zum Überspringen entscheidest."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show buttons to skip intros, recaps, and credits when community timestamps are available. Playback continues until you choose to skip."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show buttons to skip intros, recaps, and credits when community timestamps are available. Playback continues until you choose to skip."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
