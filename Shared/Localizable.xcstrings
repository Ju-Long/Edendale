          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce a esta velocidad mientras apoyas el pulgar en el lado derecho de la superficie táctil del control remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
