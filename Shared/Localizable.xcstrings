          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show buttons to skip intros, recaps, and credits when community timestamps are available. Playback continues until you choose to skip."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar botones para omitir intros, resúmenes y créditos cuando haya marcas de tiempo de la comunidad. La reproducción continúa hasta que decidas omitir."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar botones para omitir intros, resúmenes y créditos cuando haya marcas de tiempo de la comunidad. La reproducción continúa hasta que decidas omitir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher des boutons pour passer l’introduction, le résumé et le générique lorsque des repères de la communauté sont disponibles. La lecture continue jusqu’à ce que vous choisissiez de passer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i pulsanti per saltare intro, riassunti e titoli di coda quando sono disponibili i tempi della community. La riproduzione continua finché non scegli di saltare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミュニティのタイムスタンプがある場合に、イントロ、あらすじ、クレジットをスキップするボタンを表示します。スキップを選択するまで再生は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커뮤니티 타임스탬프를 사용할 수 있을 때 인트로, 요약, 크레딧을 건너뛰는 버튼을 표시합니다. 건너뛰기를 선택할 때까지 재생이 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon knoppen om intro’s, samenvattingen en aftiteling over te slaan als er tijdstempels van de community beschikbaar zijn. Het afspelen gaat door totdat je kiest om over te slaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar botões para pular aberturas, recapitulações e créditos quando houver tempos da comunidade disponíveis. A reprodução continua até você escolher pular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar botões para saltar genéricos iniciais, resumos e créditos quando existirem tempos da comunidade. A reprodução continua até escolher saltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать кнопки для пропуска вступлений, кратких содержаний и титров, когда доступны метки сообщества. Воспроизведение продолжается, пока вы не решите пропустить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa knappar för att hoppa över intron, sammanfattningar och eftertexter när det finns tidsstämplar från communityn. Uppspelningen fortsätter tills du väljer att hoppa över."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有社区时间戳时，显示跳过片头、前情提要和片尾的按钮。播放会继续，直到你选择跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有社群時間戳記時，顯示略過片頭、前情提要和片尾的按鈕。播放會繼續，直到你選擇略過。"
          }
        }
      }
    },
