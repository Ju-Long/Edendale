          }
        }
      }
    },
    "The archive never forgets a film.\nIt only waits for someone to press play." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv vergisst keinen Film.\nEs wartet nur darauf, dass jemand auf Wiedergabe drückt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive never forgets a film.\nIt only waits for someone to press play."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive never forgets a film.\nIt only waits for someone to press play."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive never forgets a film.\nIt only waits for someone to press play."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive never forgets a film.\nIt only waits for someone to press play."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo nunca olvida una película.\nSolo espera a que alguien pulse reproducir."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo nunca olvida una película.\nSolo espera a que alguien presione reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archives n’oublient jamais un film.\nElles attendent seulement qu’on appuie sur Lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’archivio non dimentica mai un film.\nAspetta solo che qualcuno prema play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブは映画を決して忘れません。\n誰かが再生を押すのを待っているだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아카이브는 영화를 결코 잊지 않습니다.\n누군가 재생을 누르기를 기다릴 뿐입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het archief vergeet nooit een film.\nHet wacht alleen tot iemand op afspelen drukt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo nunca esquece um filme.\nEle só espera alguém apertar o play."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo nunca esquece um filme.\nSó espera que alguém carregue em reproduzir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив никогда не забывает фильм.\nОн просто ждет, когда кто-нибудь нажмет «Воспроизвести»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivet glömmer aldrig en film.\nDet väntar bara på att någon ska trycka på spela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档从不遗忘任何一部电影。\n它只是在等待有人按下播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存從不遺忘任何一部電影。\n它只是在等待有人按下播放。"
          }
        }
      }
    },
