        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y mantenlos en el lado izquierdo o derecho del vídeo para reproducir a esa velocidad hasta que los separes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y mantenlos en el lado izquierdo o derecho del video para reproducir a esa velocidad hasta que los separes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez et maintenez sur le côté gauche ou droit de la vidéo pour lire à cette vitesse jusqu’à ce que vous relâchiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica e tieni premuto sul lato sinistro o destro del video per riprodurre a quella velocità finché non rilasci."
          }
