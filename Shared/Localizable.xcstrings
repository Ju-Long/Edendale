        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al revocar el acceso también se cierra la sesión en los Apple TV que hayas vinculado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
