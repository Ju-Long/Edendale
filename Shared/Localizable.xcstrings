    "Pinch and drag up or down on the right side of the video to change the volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die Finger auf der rechten Seite des Videos zusammen und ziehe nach oben oder unten, um die Lautstärke zu ändern."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and drag up or down on the right side of the video to change the volume."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and drag up or down on the right side of the video to change the volume."
          }
        },
        "en-GB" : {
          "stringUnit" : {
