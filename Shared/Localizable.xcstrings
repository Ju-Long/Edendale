          }
        }
      }
    },
    "Pinch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die Finger über der rechten Seite zusammen und halte sie, um mit %1$@ wiederzugeben, oder über der linken Seite für %2$@. Sobald du loslässt, läuft die Wiedergabe wieder mit der gewohnten Geschwindigkeit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y mantenlos en el lado derecho para reproducir a %1$@, o en el lado izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al separarlos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y mantenlos en el lado derecho para reproducir a %1$@, o en el lado izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al separarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez et maintenez sur le côté droit pour lire à %1$@, ou sur le côté gauche pour lire à %2$@. La lecture reprend sa vitesse habituelle lorsque vous relâchez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica e tieni premuto sul lato destro per riprodurre a %1$@, o sul lato sinistro per riprodurre a %2$@. La riproduzione torna alla velocità abituale quando rilasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側でピンチしたままにすると%1$@、左側では%2$@で再生します。指を離すと通常の速度に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽을 핀치한 채로 유지하면 %1$@, 왼쪽은 %2$@ 속도로 재생됩니다. 손을 떼면 원래 속도로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp en houd vast aan de rechterkant om af te spelen op %1$@, of aan de linkerkant om af te spelen op %2$@. Het afspelen keert terug naar de gebruikelijke snelheid als je loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no lado direito para reproduzir a %1$@, ou no lado esquerdo para reproduzir a %2$@. A reprodução volta à velocidade normal quando você solta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no lado direito para reproduzir a %1$@, ou no lado esquerdo para reproduzir a %2$@. A reprodução volta à velocidade habitual quando soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведите пальцы и удерживайте их на правой стороне, чтобы воспроизводить со скоростью %1$@, или на левой — со скоростью %2$@. Когда вы отпустите, скорость вернется к обычной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyp och håll på höger sida för att spela upp i %1$@, eller på vänster sida för att spela upp i %2$@. Uppspelningen återgår till sin vanliga hastighet när du släpper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在右侧捏合并保持可以 %1$@ 播放，在左侧可以 %2$@ 播放。松开后恢复正常速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在右側捏合並按住可以 %1$@ 播放，在左側可以 %2$@ 播放。放開後會恢復一般速度。"
          }
        }
      }
    },
    "Pinch and hold the video, then drag sideways to move through the timeline. Let go to jump to that moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die Finger über dem Video zusammen, halte sie und ziehe dann seitwärts, um dich durch die Zeitleiste zu bewegen. Lass los, um zu dieser Stelle zu springen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the video, then drag sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the video, then drag sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold the video, then drag sideways to move through the timeline. Let go to jump to that moment."
