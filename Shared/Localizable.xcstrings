    "Click and hold the right half of the video to play at %@, or the left half to play at %@. Playback returns to its usual speed when you release the button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf die rechte Hälfte des Videos und halte die Maustaste gedrückt, um mit %1$@ wiederzugeben, oder auf die linke Hälfte für %2$@. Sobald du die Taste loslässt, läuft die Wiedergabe wieder mit der gewohnten Geschwindigkeit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click and hold the right half of the video to play at %@, or the left half to play at %@. Playback returns to its usual speed when you release the button."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click and hold the right half of the video to play at %@, or the left half to play at %@. Playback returns to its usual speed when you release the button."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click and hold the right half of the video to play at %@, or the left half to play at %@. Playback returns to its usual speed when you release the button."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click and hold the right half of the video to play at %@, or the left half to play at %@. Playback returns to its usual speed when you release the button."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic y mantén pulsada la mitad derecha del vídeo para reproducir a %1$@, o la mitad izquierda para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al soltar el botón."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic y mantén presionada la mitad derecha del video para reproducir a %1$@, o la mitad izquierda para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al soltar el botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez et maintenez la moitié droite de la vidéo pour lire à %1$@, ou la moitié gauche pour lire à %2$@. La lecture reprend sa vitesse habituelle lorsque vous relâchez le bouton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic e tieni premuto sulla metà destra del video per riprodurre a %1$@, o sulla metà sinistra per riprodurre a %2$@. La riproduzione torna alla velocità abituale quando rilasci il pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの右半分をクリックしたままにすると%1$@、左半分では%2$@で再生します。ボタンを離すと通常の速度に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 오른쪽 절반을 클릭한 채로 있으면 %1$@, 왼쪽 절반은 %2$@ 속도로 재생됩니다. 버튼을 놓으면 원래 속도로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik en houd de rechterhelft van de video vast om af te spelen op %1$@, of de linkerhelft om af te spelen op %2$@. Het afspelen keert terug naar de gebruikelijke snelheid als je de knop loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique e mantenha pressionada a metade direita do vídeo para reproduzir a %1$@, ou a metade esquerda para reproduzir a %2$@. A reprodução volta à velocidade normal quando você solta o botão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique e mantenha premida a metade direita do vídeo para reproduzir a %1$@, ou a metade esquerda para reproduzir a %2$@. A reprodução volta à velocidade habitual quando soltar o botão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте правую половину видео, чтобы воспроизводить со скоростью %1$@, или левую половину — со скоростью %2$@. Когда вы отпустите кнопку, скорость вернется к обычной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka och håll på videons högra halva för att spela upp i %1$@, eller på den vänstra halvan för att spela upp i %2$@. Uppspelningen återgår till sin vanliga hastighet när du släpper knappen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住视频右半部分可以 %1$@ 播放，按住左半部分可以 %2$@ 播放。松开按钮后恢复正常速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住影片右半部可以 %1$@ 播放，按住左半部可以 %2$@ 播放。放開按鈕後會恢復一般速度。"
          }
        }
      }
    },
