    "Revoking access also signs out any Apple TV you linked it to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Widerrufen des Zugriffs werden auch alle Apple TV-Geräte abgemeldet, mit denen du ihn verknüpft hast."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
