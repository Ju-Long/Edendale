          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコンのタッチ面の右側に親指を置いている間、この速度で再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨 터치 표면의 오른쪽에 엄지손가락을 올려 두는 동안 이 속도로 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
