          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido verificar la cuenta de %@ de tu otro dispositivo. Vuelve a iniciar sesión en ese dispositivo e inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar la cuenta de %@ de tu otro dispositivo. Vuelve a iniciar sesión en ese dispositivo e inténtalo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte %@ de votre autre appareil n’a pas pu être vérifié. Reconnectez-vous sur cet appareil, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare l’account %@ del tuo altro dispositivo. Accedi di nuovo su quel dispositivo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスの%@アカウントを確認できませんでした。そのデバイスでもう一度サインインしてから、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기의 %@ 계정을 확인할 수 없습니다. 해당 기기에서 다시 로그인한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het %@-account van je andere apparaat kon niet worden geverifieerd. Log op dat apparaat opnieuw in en probeer het nog een keer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a conta %@ do seu outro dispositivo. Inicie a sessão nesse dispositivo novamente e tente mais uma vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a conta %@ do seu outro dispositivo. Inicie sessão novamente nesse dispositivo e tente outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить аккаунт %@ с вашего другого устройства. Войдите на том устройстве снова и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-kontot från din andra enhet kunde inte verifieras. Logga in på den enheten igen och försök sedan en gång till."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证来自你其他设备的 %@ 帐户。请在该设备上重新登录，然后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
