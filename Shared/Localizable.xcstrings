          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ account from your other device couldn't be verified. Sign in on that device again, then try once more."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
