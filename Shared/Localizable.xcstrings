    "Increase gamma to brighten dark and middle tones. High settings can reveal noise or wash out the picture." : {
      "comment" : "A description of how to adjust the gamma of a video.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe Gamma, um dunkle und mittlere Töne aufzuhellen. Hohe Werte können Rauschen sichtbar machen oder das Bild blass wirken lassen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase gamma to brighten dark and middle tones. High settings can reveal noise or wash out the picture."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase gamma to brighten dark and middle tones. High settings can reveal noise or wash out the picture."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase gamma to brighten dark and middle tones. High settings can reveal noise or wash out the picture."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase gamma to brighten dark and middle tones. High settings can reveal noise or wash out the picture."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la gamma para aclarar los tonos oscuros y medios. Los valores altos pueden mostrar ruido o desvaír la imagen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la gamma para aclarar los tonos oscuros y medios. Los valores altos pueden mostrar ruido o deslavar la imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez le gamma pour éclaircir les tons sombres et moyens. Des valeurs élevées peuvent faire apparaître du bruit ou délaver l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la gamma per schiarire i toni scuri e medi. Valori alti possono far emergere il rumore o sbiadire l’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガンマを上げると暗部と中間調が明るくなります。高い設定ではノイズが目立ったり、映像が白っぽくなったりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감마를 높이면 어두운 영역과 중간 톤이 밝아집니다. 값이 높으면 노이즈가 드러나거나 화면이 바랠 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhoog gamma om donkere en middentonen lichter te maken. Hoge waarden kunnen ruis zichtbaar maken of het beeld flets maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente a gama para clarear os tons escuros e médios. Valores altos podem revelar ruído ou desbotar a imagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente a gama para clarear os tons escuros e médios. Valores altos podem revelar ruído ou desbotar a imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличьте гамму, чтобы осветлить темные и средние тона. При высоких значениях может проявиться шум или изображение может выглядеть блеклым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öka gamma för att göra mörka toner och mellantoner ljusare. Höga värden kan synliggöra brus eller göra bilden blek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高伽马值可提亮暗部和中间调。设置过高可能会显露噪点或使画面发白。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高伽瑪值可提亮暗部和中間色調。設定過高可能會顯露雜訊或使畫面泛白。"
          }
        }
      }
    },
