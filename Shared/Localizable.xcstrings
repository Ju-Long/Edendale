          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays a matching local movie or episode, or opens search when no local file matches."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce una película o episodio local coincidente, o abre la búsqueda cuando no coincide ningún archivo local."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce una película o episodio local coincidente, o abre la búsqueda cuando no coincide ningún archivo local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit un film ou un épisode local correspondant, ou ouvre la recherche si aucun fichier local ne correspond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un film o un episodio locale corrispondente, o apre la ricerca se nessun file locale corrisponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するローカルの映画またはエピソードを再生するか、一致するローカルファイルがない場合は検索を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 로컬 영화나 에피소드를 재생하거나, 일치하는 로컬 파일이 없으면 검색을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een overeenkomende lokale film of aflevering af, of opent zoeken wanneer er geen lokaal bestand overeenkomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um filme ou episódio local correspondente, ou abre a busca quando nenhum arquivo local corresponde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um filme ou episódio local correspondente, ou abre a pesquisa quando não há nenhum ficheiro local correspondente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит подходящий локальный фильм или эпизод, либо открывает поиск, если совпадений нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar en matchande lokal film eller ett avsnitt, eller öppnar sökningen om ingen lokal fil matchar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放匹配的本地电影或单集，如果本地没有匹配的文件，则打开搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放相符的本機電影或劇集，或者在沒有相符的本機檔案時打開搜尋。"
          }
        }
      }
    },
