          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la première connexion, Edendale affiche la clé d’hôte du serveur pour que vous l’approuviez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla prima connessione, Edendale mostra la chiave host del server da approvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendaleは初めて接続するときに、承認のためにサーバーのホストキーを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale은 처음 연결할 때 승인할 수 있도록 서버의 호스트 키를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste keer dat Edendale verbinding maakt, toont het de hostsleutel van de server zodat je die kunt goedkeuren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na primeira conexão, o Edendale mostra a chave de host do servidor para você aprovar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na primeira ligação, o Edendale mostra a chave de anfitrião do servidor para que a aprove."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При первом подключении Edendale показывает ключ хоста сервера, чтобы вы его подтвердили."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Första gången Edendale ansluter visas serverns värdnyckel så att du kan godkänna den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale 首次连接时，会显示服务器的主机密钥供你批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale 首次連線時，會顯示伺服器的主機金鑰供你核准。"
          }
        }
      }
    },
    "The key %@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel, den %1$@ vorlegt, ist nicht derjenige, den du zuvor bestätigt hast. Fahre nur fort, wenn du weißt, dass der Server neu installiert oder sein Schlüssel geändert wurde.\n\n%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The key %1$@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%2$@"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key %1$@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%2$@"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key %1$@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%2$@"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key %1$@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%2$@"
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key %1$@ presents isn't the one you approved before. Only continue if you know the server was reinstalled or its key was changed.\n\n%2$@"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave que presenta %1$@ no es la que aprobaste antes. Continúa solo si sabes que el servidor se ha reinstalado o que su clave ha cambiado.\n\n%2$@"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave que presenta %1$@ no es la que aprobaste antes. Continúa solo si sabes que el servidor se reinstaló o que su clave cambió.\n\n%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé présentée par %1$@ n’est pas celle que vous avez approuvée auparavant. Ne continuez que si vous savez que le serveur a été réinstallé ou que sa clé a été modifiée.\n\n%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave presentata da %1$@ non è quella che hai approvato in precedenza. Continua solo se sai che il server è stato reinstallato o che la sua chiave è stata cambiata.\n\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が提示したキーは、以前に承認したものと異なります。サーバーが再インストールされたか、キーが変更されたことがわかっている場合にのみ続行してください。\n\n%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 제시한 키가 이전에 승인한 키와 다릅니다. 서버가 재설치되었거나 키가 변경된 것을 알고 있는 경우에만 계속하십시오.\n\n%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutel die %1$@ toont, is niet de sleutel die je eerder hebt goedgekeurd. Ga alleen verder als je weet dat de server opnieuw is geïnstalleerd of dat de sleutel is gewijzigd.\n\n%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave apresentada por %1$@ não é a que você aprovou antes. Só continue se souber que o servidor foi reinstalado ou que a chave dele foi alterada.\n\n%2$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave apresentada por %1$@ não é a que aprovou anteriormente. Continue apenas se souber que o servidor foi reinstalado ou que a chave foi alterada.\n\n%2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ, который предъявляет %1$@, отличается от подтвержденного ранее. Продолжайте, только если знаете, что сервер переустановили или его ключ изменили.\n\n%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyckeln som %1$@ visar är inte den du godkände tidigare. Fortsätt bara om du vet att servern har installerats om eller att dess nyckel har ändrats.\n\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 提供的密钥与你之前批准的不同。仅当你确定服务器已重装或其密钥已更改时才继续。\n\n%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 提供的金鑰與你先前核准的不同。只有在你確定伺服器已重新安裝或其金鑰已更改時才繼續。\n\n%2$@"
          }
        }
      }
    },
