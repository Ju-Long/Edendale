          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un carré pour commencer une sélection. Les carrés plus clairs contiennent plus de sorties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un riquadro per iniziare una selezione. I riquadri più luminosi contengono più uscite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスをタップして選択を開始します。明るいマスほど公開作品の数が多くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사각형을 탭하여 선택을 시작하십시오. 사각형이 밝을수록 공개된 작품이 더 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een vierkant om een selectie te starten. Lichtere vierkanten bevatten meer releases."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um quadrado para iniciar uma seleção. Quadrados mais brilhantes contêm mais lançamentos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num quadrado para iniciar uma seleção. Quadrados mais brilhantes contêm mais lançamentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь квадрата, чтобы начать выбор. Чем ярче квадрат, тем больше премьер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en ruta för att starta ett urval. Ljusare rutor innehåller fler premiärer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
