        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic una vez en el vídeo para mostrar u ocultar los controles. Desaparecen solos tras cinco segundos de reproducción."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic una vez en el video para mostrar u ocultar los controles. Desaparecen solos después de cinco segundos de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez une fois sur la vidéo pour afficher ou masquer les commandes. Elles disparaissent d’elles-mêmes après cinq secondes de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic una volta sul video per mostrare o nascondere i controlli. Scompaiono da soli dopo cinque secondi di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを1回クリックすると、コントロールの表示/非表示を切り替えます。再生が始まって5秒たつと自動的に消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 한 번 클릭하면 제어기를 보거나 가릴 수 있습니다. 재생 중 5초가 지나면 자동으로 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik één keer op de video om de regelaars te tonen of te verbergen. Na vijf seconden afspelen verdwijnen ze vanzelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique uma vez no vídeo para mostrar ou ocultar os controles. Eles desaparecem sozinhos após cinco segundos de reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique uma vez no vídeo para mostrar ou ocultar os controlos. Desaparecem sozinhos após cinco segundos de reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелкните видео один раз, чтобы показать или скрыть элементы управления. Через пять секунд воспроизведения они скроются сами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka en gång på videon för att visa eller dölja reglagen. De försvinner av sig själva efter fem sekunders uppspelning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
