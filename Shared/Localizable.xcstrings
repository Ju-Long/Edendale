        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” se quita de tu biblioteca. No se borra nada en %2$@ y tu cuenta sigue vinculada en Configuración → Cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est retiré de votre bibliothèque. Rien n’est supprimé dans %2$@ et votre compte reste lié dans Réglages → Comptes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
