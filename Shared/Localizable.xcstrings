    "Double-tap the left or right side of the video to skip back or forward. The Lock Screen and Control Center use the same lengths." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf die linke oder rechte Seite des Videos, um zurück- oder vorzuspringen. Der Sperrbildschirm und das Kontrollzentrum verwenden dieselben Längen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the left or right side of the video to skip back or forward. The Lock Screen and Control Centre use the same lengths."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the left or right side of the video to skip back or forward. The Lock Screen and Control Centre use the same lengths."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the left or right side of the video to skip back or forward. The Lock Screen and Control Centre use the same lengths."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the left or right side of the video to skip back or forward. The Lock Screen and Control Center use the same lengths."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado izquierdo o derecho del vídeo para retroceder o avanzar. La pantalla bloqueada y el centro de control usan los mismos intervalos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado izquierdo o derecho del video para retroceder o avanzar. La pantalla bloqueada y el centro de control usan los mismos intervalos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois le côté gauche ou droit de la vidéo pour reculer ou avancer. L’écran verrouillé et le centre de contrôle utilisent les mêmes durées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il lato sinistro o destro del video per tornare indietro o andare avanti. La schermata di blocco e Centro di Controllo usano gli stessi intervalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの左側または右側をダブルタップすると、前後にスキップします。ロック画面とコントロールセンターでも同じ秒数が使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 왼쪽 또는 오른쪽을 이중 탭하여 뒤로 또는 앞으로 건너뜁니다. 잠금 화면과 제어 센터에서도 같은 간격을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer op de linker- of rechterkant van de video om terug of vooruit te springen. Het toegangsscherm en het bedieningspaneel gebruiken dezelfde lengtes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado esquerdo ou direito do vídeo para voltar ou avançar. A Tela Bloqueada e a Central de Controle usam os mesmos intervalos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado esquerdo ou direito do vídeo para recuar ou avançar. O ecrã bloqueado e a central de controlo usam os mesmos intervalos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь левой или правой части видео, чтобы перемотать назад или вперед. На экране блокировки и в Пункте управления используются те же интервалы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck två gånger på vänster eller höger sida av videon för att hoppa bakåt eller framåt. Låsskärmen och Kontrollcenter använder samma längder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两下视频的左侧或右侧可向后或向前跳转。锁定屏幕和控制中心使用相同的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下影片的左側或右側即可倒轉或快轉。鎖定畫面和控制中心使用相同的時間長度。"
          }
        }
      }
    },
    "Double-tap the right side to jump forward %lld seconds, or the left side to jump back %lld seconds. Double-tap the middle to play or pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf die rechte Seite, um %1$lld Sekunden vorzuspringen, oder auf die linke Seite, um %2$lld Sekunden zurückzuspringen. Tippe zweimal auf die Mitte, um abzuspielen oder anzuhalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the right side to jump forward %lld seconds, or the left side to jump back %lld seconds. Double-tap the middle to play or pause."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the right side to jump forward %lld seconds, or the left side to jump back %lld seconds. Double-tap the middle to play or pause."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the right side to jump forward %lld seconds, or the left side to jump back %lld seconds. Double-tap the middle to play or pause."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap the right side to jump forward %lld seconds, or the left side to jump back %lld seconds. Double-tap the middle to play or pause."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado derecho para avanzar %1$lld segundos o el lado izquierdo para retroceder %2$lld segundos. Toca dos veces el centro para reproducir o pausar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado derecho para avanzar %1$lld segundos o el lado izquierdo para retroceder %2$lld segundos. Toca dos veces el centro para reproducir o pausar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois le côté droit pour avancer de %1$lld secondes, ou le côté gauche pour reculer de %2$lld secondes. Touchez deux fois le centre pour lire ou mettre en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il lato destro per andare avanti di %1$lld secondi o il lato sinistro per tornare indietro di %2$lld secondi. Tocca due volte il centro per riprodurre o mettere in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側をダブルタップすると%1$lld秒進み、左側をダブルタップすると%2$lld秒戻ります。中央をダブルタップすると再生/一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽을 이중 탭하면 %1$lld초 앞으로, 왼쪽을 이중 탭하면 %2$lld초 뒤로 이동합니다. 가운데를 이중 탭하면 재생하거나 일시 정지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik op de rechterkant om %1$lld seconden vooruit te springen, of op de linkerkant om %2$lld seconden terug te springen. Dubbeltik in het midden om af te spelen of te pauzeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado direito para avançar %1$lld segundos ou no lado esquerdo para voltar %2$lld segundos. Toque duas vezes no centro para reproduzir ou pausar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado direito para avançar %1$lld segundos ou no lado esquerdo para recuar %2$lld segundos. Toque duas vezes no centro para reproduzir ou pausar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь правой стороны, чтобы перемотать вперед на %1$lld с, или левой стороны, чтобы вернуться на %2$lld с. Дважды коснитесь середины, чтобы начать или приостановить воспроизведение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltryck på höger sida för att hoppa framåt %1$lld sekunder, eller på vänster sida för att hoppa bakåt %2$lld sekunder. Dubbeltryck i mitten för att spela upp eller pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两下右侧可快进 %1$lld 秒，连按两下左侧可快退 %2$lld 秒。连按两下中间可播放或暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下右側可快轉 %1$lld 秒，點兩下左側可倒轉 %2$lld 秒。點兩下中間可播放或暫停。"
          }
        }
      }
    },
