    "%@ — tap the same square for a single day, or another square to finish the range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tippe auf dasselbe Quadrat für einen einzelnen Tag oder auf ein anderes, um den Bereich zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tap the same square for a single day, or another square to finish the range."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tap the same square for a single day, or another square to finish the range."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tap the same square for a single day, or another square to finish the range."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tap the same square for a single day, or another square to finish the range."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tap the same square for a single day, or another square to finish the range."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — toca el mismo cuadrado para un solo día u otro cuadrado para terminar el rango."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — toca el mismo cuadro para un solo día u otro cuadro para terminar el rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — touchez le même carré pour un jour unique, ou un autre carré pour terminer la plage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tocca lo stesso riquadro per un singolo giorno, o un altro riquadro per terminare l'intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 同じマスをタップすると1日のみ、別のマスをタップすると範囲が完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 하루를 선택하려면 같은 사각형을 탭하고, 범위를 지정하려면 다른 사각형을 탭하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tik op hetzelfde vierkant voor één dag, of een ander vierkant om de reeks te voltooien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — toque no mesmo quadrado para um único dia, ou em outro quadrado para finalizar o intervalo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — toque no mesmo quadrado para um dia, ou noutro quadrado para terminar o intervalo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — коснитесь того же квадрата для одного дня или другого, чтобы завершить диапазон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tryck på samma ruta för en enskild dag, eller en annan ruta för att avsluta intervallet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 轻点同一个方块选择单日，或轻点另一个方块以完成范围选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 點按同一個方塊選擇單日，或點按另一個方塊以完成範圍。"
          }
        }
      }
    },
