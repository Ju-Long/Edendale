    "Plays a matching local movie or episode, or opens search when no local file matches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt einen passenden lokalen Film oder eine Folge wieder oder öffnet die Suche, wenn keine lokale Datei übereinstimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays a matching local movie or episode, or opens search when no local file matches."
          }
        },
        "en-AU" : {
