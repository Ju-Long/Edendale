    "Use HTTPS for servers outside your local network. Plain HTTP works only for local addresses such as nas.local or 192.168.1.10." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende HTTPS für Server außerhalb deines lokalen Netzwerks. Einfaches HTTP funktioniert nur für lokale Adressen wie nas.local oder 192.168.1.10."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS for servers outside your local network. Plain HTTP works only for local addresses such as nas.local or 192.168.1.10."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS for servers outside your local network. Plain HTTP works only for local addresses such as nas.local or 192.168.1.10."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS for servers outside your local network. Plain HTTP works only for local addresses such as nas.local or 192.168.1.10."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS for servers outside your local network. Plain HTTP works only for local addresses such as nas.local or 192.168.1.10."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa HTTPS para servidores fuera de tu red local. El HTTP simple solo funciona con direcciones locales como nas.local o 192.168.1.10."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa HTTPS para servidores fuera de tu red local. El HTTP simple solo funciona con direcciones locales como nas.local o 192.168.1.10."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez HTTPS pour les serveurs hors de votre réseau local. Le HTTP simple fonctionne uniquement pour les adresses locales comme nas.local ou 192.168.1.10."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa HTTPS per i server fuori dalla tua rete locale. L’HTTP semplice funziona solo per indirizzi locali come nas.local o 192.168.1.10."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク外のサーバーにはHTTPSを使用してください。プレーンなHTTPは、nas.localや192.168.1.10などのローカルアドレスでのみ機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크 외부의 서버에는 HTTPS를 사용하십시오. 일반 HTTP는 nas.local 또는 192.168.1.10과 같은 로컬 주소에서만 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik HTTPS voor servers buiten je lokale netwerk. Gewone HTTP werkt alleen voor lokale adressen zoals nas.local of 192.168.1.10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS para servidores fora da sua rede local. O HTTP simples só funciona para endereços locais como nas.local ou 192.168.1.10."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use HTTPS para servidores fora da sua rede local. O HTTP simples só funciona para endereços locais como nas.local ou 192.168.1.10."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте HTTPS для серверов вне вашей локальной сети. Обычный HTTP работает только для локальных адресов, например nas.local или 192.168.1.10."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd HTTPS för servrar utanför ditt lokala nätverk. Vanlig HTTP fungerar bara för lokala adresser som nas.local eller 192.168.1.10."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于本地网络以外的服务器，请使用 HTTPS。普通 HTTP 仅适用于本地地址，例如 nas.local 或 192.168.1.10。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於區域網路以外的伺服器，請使用 HTTPS。一般 HTTP 只適用於本機位址，例如 nas.local 或 192.168.1.10。"
          }
        }
      }
    },
