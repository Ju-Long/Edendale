        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” wordt uit je bibliotheek verwijderd. Er wordt niets verwijderd in %2$@ en je account blijft gekoppeld in Instellingen → Accounts."
          }
