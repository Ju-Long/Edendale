            "value" : "No se puede acceder a las carpetas locales desde el Apple TV. Enlaza un recurso compartido de red (SMB) para crear tu biblioteca."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a las carpetas locales desde el Apple TV. Vincula un recurso compartido de red (SMB) para crear tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
