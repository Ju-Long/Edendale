        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 上的 Edendale 正在请求你的 %2$@ 访问权限。该权限会保留在那台 Apple TV 上，直到你在那里退出登录。"
