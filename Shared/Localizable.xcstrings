    "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf %@ nicht möglich. Das Objekt befindet sich möglicherweise auf einem getrennten Laufwerk, oder sein Ordner muss erneut hinzugefügt werden, um die Berechtigung wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't access %@. It may be on a disconnected drive, or its folder needs to be re-added to restore permission."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a %@. Es posible que esté en un disco desconectado o que haya que volver a añadir su carpeta para restaurar el permiso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a %@. Puede que esté en un disco desconectado o que haya que volver a agregar su carpeta para restaurar el permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'accéder à %@. Il se peut qu'il soit sur un lecteur déconnecté, ou que son dossier doive être ajouté à nouveau pour restaurer l'autorisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile accedere a %@. Potrebbe trovarsi su un'unità scollegata o potrebbe essere necessario aggiungere di nuovo la cartella per ripristinare i permessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にアクセスできません。ドライブが切断されているか、アクセス権を復元するためにフォルダを再追加する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 접근할 수 없습니다. 연결이 해제된 드라이브에 있거나 권한 복원을 위해 폴더를 다시 추가해야 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen toegang tot %@. Het staat mogelijk op een losgekoppelde schijf, of de map moet opnieuw worden toegevoegd om de bevoegdheid te herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar %@. Pode estar em um disco desconectado, ou sua pasta precisa ser adicionada novamente para restaurar a permissão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível aceder a %@. Pode estar num disco desligado ou a sua pasta precisa de ser adicionada novamente para repor a permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступа к %@. Возможно, файл находится на отключенном диске, или папку нужно добавить заново для восстановления прав доступа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte komma åt %@. Den kan ligga på en frånkopplad enhet, eller så måste mappen läggas till igen för att återställa behörigheten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问 %@。它可能在已断开连接的驱动器上，或者需要重新添加其文件夹以恢复权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法存取 %@。其可能位於已中斷連線的磁碟，或需要重新加入其檔案夾以回復權限。"
          }
        }
      }
    },
    "Can't reach %@. Check that the server is on, on the same network, and that the name or credentials are correct." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nicht erreichbar. Überprüfe, ob der Server eingeschaltet ist, sich im selben Netzwerk befindet und Name oder Anmeldedaten korrekt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach %@. Check that the server is on, on the same network, and that the name or credentials are correct."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach %@. Check that the server is on, on the same network, and that the name or credentials are correct."
          }
        },
        "en-CA" : {
          "stringUnit" : {
