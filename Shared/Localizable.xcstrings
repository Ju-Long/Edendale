        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La révocation de l’accès déconnecte aussi toutes les Apple TV auxquelles vous l’avez lié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revocando l’accesso esci anche da tutte le Apple TV a cui l’hai collegato."
