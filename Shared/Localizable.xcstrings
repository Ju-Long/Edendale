    "Swipe up or down on the left side to change the screen brightness, or on the right side to change the volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche auf der linken Seite nach oben oder unten, um die Bildschirmhelligkeit zu ändern, oder auf der rechten Seite, um die Lautstärke zu ändern."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down on the left side to change the screen brightness, or on the right side to change the volume."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down on the left side to change the screen brightness, or on the right side to change the volume."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down on the left side to change the screen brightness, or on the right side to change the volume."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down on the left side to change the screen brightness, or on the right side to change the volume."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo en el lado izquierdo para cambiar el brillo de la pantalla, o en el lado derecho para cambiar el volumen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo en el lado izquierdo para cambiar el brillo de la pantalla, o en el lado derecho para cambiar el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas sur le côté gauche pour modifier la luminosité de l’écran, ou sur le côté droit pour modifier le volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l’alto o verso il basso sul lato sinistro per cambiare la luminosità dello schermo, o sul lato destro per cambiare il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左側を上下にスワイプすると画面の明るさ、右側を上下にスワイプすると音量を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽에서 위아래로 쓸어넘기면 화면 밝기를, 오른쪽에서 쓸어넘기면 음량을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog of omlaag aan de linkerkant om de schermhelderheid te wijzigen, of aan de rechterkant om het volume te wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para cima ou para baixo no lado esquerdo para alterar o brilho da tela, ou no lado direito para alterar o volume."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o dedo para cima ou para baixo no lado esquerdo para alterar o brilho do ecrã, ou no lado direito para alterar o volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вверх или вниз на левой стороне, чтобы изменить яркость экрана, или на правой стороне, чтобы изменить громкость."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt eller nedåt på vänster sida för att ändra skärmens ljusstyrka, eller på höger sida för att ändra volymen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
