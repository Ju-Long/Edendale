        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorgenti di %@ smettono di funzionare su questa Apple TV finché non ricolleghi l’account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
