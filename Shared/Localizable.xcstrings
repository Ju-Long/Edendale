    "Sources from %@ stop working on this device and your other devices that share your iCloud Keychain, until you sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen von %@ funktionieren auf diesem Gerät und deinen anderen Geräten mit demselben iCloud-Schlüsselbund nicht mehr, bis du dich erneut anmeldest."
          }
        },
        "en-AU" : {
