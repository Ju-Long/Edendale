          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のEdendaleが%2$@へのアクセスを要求しています。アクセスは、そのApple TVでサインアウトするまでそのApple TVに保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 Edendale이 %2$@ 접근 권한을 요청하고 있습니다. 해당 Apple TV에서 로그아웃할 때까지 그 Apple TV에 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale op %1$@ vraagt om je toegang tot %2$@. Die blijft op die Apple TV totdat je daar uitlogt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Edendale em %1$@ está pedindo seu acesso a %2$@. Ele fica nessa Apple TV até você finalizar a sessão lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
