    "Touch and hold the left or right side of the video to play at that speed until you let go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf die linke oder rechte Seite des Videos und halte ihn dort, um mit dieser Geschwindigkeit wiederzugeben, bis du loslässt."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the left or right side of the video to play at that speed until you let go."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the left or right side of the video to play at that speed until you let go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the left or right side of the video to play at that speed until you let go."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the left or right side of the video to play at that speed until you let go."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el lado izquierdo o derecho del vídeo para reproducir a esa velocidad hasta que lo sueltes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el lado izquierdo o derecho del video para reproducir a esa velocidad hasta que lo sueltes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez le côté gauche ou droit de la vidéo pour lire à cette vitesse jusqu’à ce que vous relâchiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il lato sinistro o destro del video per riprodurre a quella velocità finché non rilasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの左側または右側をタッチしたままにすると、指を離すまでその速度で再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 왼쪽 또는 오른쪽을 길게 터치하면 손을 뗄 때까지 해당 속도로 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de linker- of rechterkant van de video aangeraakt om op die snelheid af te spelen totdat je loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado o lado esquerdo ou direito do vídeo para reproduzir nessa velocidade até soltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha o dedo no lado esquerdo ou direito do vídeo para reproduzir a essa velocidade até soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь левой или правой части видео и удерживайте палец, чтобы воспроизводить с этой скоростью, пока не отпустите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på vänster eller höger sida av videon för att spela upp i den hastigheten tills du släpper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸并按住视频的左侧或右侧，即可以该速度播放，直到你松开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住影片的左側或右側，即可以該速度播放，直到你放開。"
          }
        }
      }
    },
    "Touch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf die rechte Seite und halte ihn dort, um mit %1$@ wiederzugeben, oder auf die linke Seite für %2$@. Sobald du loslässt, läuft die Wiedergabe wieder mit der gewohnten Geschwindigkeit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the right side to play at %@, or the left side to play at %@. Playback returns to its usual speed when you let go."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el lado derecho para reproducir a %1$@, o el lado izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al soltarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el lado derecho para reproducir a %1$@, o el lado izquierdo para reproducir a %2$@. La reproducción vuelve a su velocidad habitual al soltarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez le côté droit pour lire à %1$@, ou le côté gauche pour lire à %2$@. La lecture reprend sa vitesse habituelle lorsque vous relâchez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il lato destro per riprodurre a %1$@, o il lato sinistro per riprodurre a %2$@. La riproduzione torna alla velocità abituale quando rilasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側をタッチしたままにすると%1$@、左側では%2$@で再生します。指を離すと通常の速度に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽을 길게 터치하면 %1$@, 왼쪽은 %2$@ 속도로 재생됩니다. 손을 떼면 원래 속도로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de rechterkant aangeraakt om af te spelen op %1$@, of de linkerkant om af te spelen op %2$@. Het afspelen keert terug naar de gebruikelijke snelheid als je loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado o lado direito para reproduzir a %1$@, ou o lado esquerdo para reproduzir a %2$@. A reprodução volta à velocidade normal quando você solta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha o dedo no lado direito para reproduzir a %1$@, ou no lado esquerdo para reproduzir a %2$@. A reprodução volta à velocidade habitual quando soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь правой стороны и удерживайте палец, чтобы воспроизводить со скоростью %1$@, или левой стороны — со скоростью %2$@. Когда вы отпустите, скорость вернется к обычной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på höger sida för att spela upp i %1$@, eller på vänster sida för att spela upp i %2$@. Uppspelningen återgår till sin vanliga hastighet när du släpper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸并按住右侧可以 %1$@ 播放，按住左侧可以 %2$@ 播放。松开后恢复正常速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住右側可以 %1$@ 播放，按住左側可以 %2$@ 播放。放開後會恢復一般速度。"
          }
        }
      }
    },
    "Touch and hold the video, then slide sideways to move through the timeline. Let go to jump to that moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf das Video, halte ihn und ziehe dann seitwärts, um dich durch die Zeitleiste zu bewegen. Lass los, um zu dieser Stelle zu springen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the video, then slide sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the video, then slide sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the video, then slide sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the video, then slide sideways to move through the timeline. Let go to jump to that moment."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el vídeo y desliza hacia los lados para moverte por la línea de tiempo. Suelta para saltar a ese momento."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el video y desliza hacia los lados para moverte por la línea de tiempo. Suelta para saltar a ese momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez la vidéo, puis faites glisser latéralement pour parcourir la chronologie. Relâchez pour accéder à ce moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il video, poi scorri lateralmente per spostarti nella timeline. Rilascia per saltare a quel momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオをタッチしたまま横にスライドすると、タイムライン上を移動できます。指を離すとその位置にジャンプします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 길게 터치한 다음 옆으로 밀면 타임라인을 이동할 수 있습니다. 손을 떼면 해당 지점으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de video aangeraakt en schuif dan zijwaarts om door de tijdlijn te bewegen. Laat los om naar dat moment te springen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado o vídeo, depois deslize para os lados para percorrer a linha do tempo. Solte para ir para esse momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha o dedo no vídeo e, depois, deslize para os lados para percorrer a linha cronológica. Solte para saltar para esse momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь видео и, удерживая палец, сдвиньте его в сторону, чтобы перемещаться по шкале времени. Отпустите, чтобы перейти к этому моменту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på videon och dra sedan åt sidan för att röra dig längs tidslinjen. Släpp för att hoppa till det ögonblicket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸并按住视频，然后左右滑动即可在时间线中移动。松开即可跳到该位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住影片，然後左右滑動即可在時間列中移動。放開即可跳至該位置。"
          }
        }
      }
    },
