          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos para omitir están disponibles en la reproducción estándar. La reproducción espacial en el reproductor del sistema aún no es compatible."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos para omitir están disponibles en la reproducción estándar. La reproducción espacial en el reproductor del sistema aún no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons pour passer sont disponibles en lecture standard. La lecture spatiale dans le lecteur système n’est pas encore prise en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti per saltare sono disponibili nella riproduzione standard. La riproduzione spaziale nel lettore di sistema non è ancora supportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップボタンは通常の再生で利用できます。システムプレーヤーでの空間再生にはまだ対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건너뛰기 버튼은 일반 재생에서 사용할 수 있습니다. 시스템 플레이어의 공간 재생은 아직 지원되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
