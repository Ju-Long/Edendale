          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale на %1$@ запрашивает ваш доступ к %2$@. Он остается на этом Apple TV, пока вы не выйдете там."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edendale på %1$@ ber om din åtkomst till %2$@. Den stannar på den Apple TV:n tills du loggar ut där."
