        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los controles ocultos, desliza a la derecha en el clickpad para avanzar %1$lld segundos o a la izquierda para retroceder %2$lld segundos. Desliza hacia abajo para ver la línea de tiempo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los controles ocultos, desliza a la derecha en el clickpad para avanzar %1$lld segundos o a la izquierda para retroceder %2$lld segundos. Desliza hacia abajo para ver la línea de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque les commandes sont masquées, balayez vers la droite sur le pavé tactile pour avancer de %1$lld secondes, ou vers la gauche pour reculer de %2$lld secondes. Balayez vers le bas pour voir la chronologie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con i controlli nascosti, scorri a destra sul clickpad per andare avanti di %1$lld secondi o a sinistra per tornare indietro di %2$lld secondi. Scorri verso il basso per vedere la timeline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールが隠れているときにクリックパッドを右にスワイプすると%1$lld秒進み、左にスワイプすると%2$lld秒戻ります。下にスワイプするとタイムラインが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어기가 가려져 있을 때 클릭패드에서 오른쪽으로 쓸어넘기면 %1$lld초 앞으로, 왼쪽으로 쓸어넘기면 %2$lld초 뒤로 이동합니다. 아래로 쓸어내리면 타임라인이 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg terwijl de regelaars verborgen zijn naar rechts op de clickpad om %1$lld seconden vooruit te springen, of naar links om %2$lld seconden terug te springen. Veeg omlaag om de tijdlijn te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os controles ocultos, deslize para a direita no clickpad para avançar %1$lld segundos ou para a esquerda para voltar %2$lld segundos. Deslize para baixo para ver a linha do tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os controlos ocultos, passe o dedo para a direita no clickpad para avançar %1$lld segundos ou para a esquerda para recuar %2$lld segundos. Passe o dedo para baixo para ver a linha cronológica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда элементы управления скрыты, смахните вправо на кликпаде, чтобы перемотать вперед на %1$lld с, или влево, чтобы вернуться на %2$lld с. Смахните вниз, чтобы увидеть шкалу времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När reglagen är dolda sveper du åt höger på klickplattan för att hoppa framåt %1$lld sekunder, eller åt vänster för att hoppa bakåt %2$lld sekunder. Svep nedåt för att se tidslinjen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制隐藏时，在触控板上向右轻扫可快进 %1$lld 秒，向左轻扫可快退 %2$lld 秒。向下轻扫可查看时间线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制項目隱藏時，在觸控板上向右滑動可快轉 %1$lld 秒，向左滑動可倒轉 %2$lld 秒。向下滑動可查看時間列。"
          }
        }
      }
    },
