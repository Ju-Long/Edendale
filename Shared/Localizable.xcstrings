          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and drag up or down on the right side of the video to change the volume."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y arrastra hacia arriba o hacia abajo en el lado derecho del vídeo para cambiar el volumen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y arrastra hacia arriba o hacia abajo en el lado derecho del video para cambiar el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez et faites glisser vers le haut ou le bas sur le côté droit de la vidéo pour modifier le volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica e trascina verso l’alto o verso il basso sul lato destro del video per cambiare il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの右側でピンチしたまま上下にドラッグすると、音量を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 오른쪽에서 핀치한 채로 위아래로 드래그하면 음량을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp en sleep omhoog of omlaag aan de rechterkant van de video om het volume te wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e arraste para cima ou para baixo no lado direito do vídeo para alterar o volume."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e arraste para cima ou para baixo no lado direito do vídeo para alterar o volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведите пальцы и перетащите вверх или вниз на правой стороне видео, чтобы изменить громкость."
          }
        },
        "sv" : {
          "stringUnit" : {
