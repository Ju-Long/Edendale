    "Leave both empty to connect as guest. The password is stored only in your Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass beide leer, um dich als Gast zu verbinden. Das Passwort wird nur in deinem Schlüsselbund gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja ambos en blanco para conectar como invitado. La contraseña solo se guarda en el llavero."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja ambos en blanco para conectarte como invitado. La contraseña solo se guarda en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les deux champs vides pour vous connecter en tant qu'invité. Le mot de passe est stocké uniquement dans votre trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia entrambi i campi vuoti per connetterti come ospite. La password viene archiviata solo nel portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストとして接続するには両方を空にしてください。パスワードはキーチェーンにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트로 연결하려면 둘 다 비워 두십시오. 암호는 키체인에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat beide leeg om als gast te verbinden. Het wachtwoord wordt alleen in je sleutelhanger bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ambos vazios para conectar como convidado. A senha é armazenada apenas nas suas Chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ambos os campos vazios para ligar como convidado. A palavra-passe é guardada apenas no seu porta-chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте оба поля пустыми для гостевого входа. Пароль надежно хранится в Связке ключей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna båda tomma för att ansluta som gäst. Lösenordet sparas endast i din nyckelring."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空以访客身份连接。密码仅存储在你的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將兩者留空即可作為訪客連線。密碼僅會儲存在你的鑰匙圈中。"
          }
        }
      }
    },
    "Leave the export path empty to list the server's exports. Apple devices connect from an unprivileged port, so the export needs the “insecure” option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Freigabepfad leer, um die Freigaben des Servers aufzulisten. Apple-Geräte verbinden sich von einem nicht privilegierten Port aus, daher benötigt die Freigabe die Option „insecure“."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the export path empty to list the server's exports. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the export path empty to list the server's exports. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the export path empty to list the server's exports. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the export path empty to list the server's exports. Apple devices connect from an unprivileged port, so the export needs the “insecure” option."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la ruta de exportación vacía para ver las exportaciones del servidor. Los dispositivos Apple se conectan desde un puerto sin privilegios, así que la exportación necesita la opción «insecure»."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la ruta de exportación vacía para ver las exportaciones del servidor. Los dispositivos Apple se conectan desde un puerto sin privilegios, así que la exportación necesita la opción “insecure”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le chemin d’export vide pour lister les exports du serveur. Les appareils Apple se connectent depuis un port non privilégié, l’export doit donc avoir l’option « insecure »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto il percorso export per elencare gli export del server. I dispositivi Apple si connettono da una porta non privilegiata, quindi l’export richiede l’opzione “insecure”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのエクスポートを一覧表示するには、エクスポートパスを空のままにしてください。Appleデバイスは非特権ポートから接続するため、エクスポートには“insecure”オプションが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 내보내기 목록을 보려면 내보내기 경로를 비워 두십시오. Apple 기기는 비특권 포트에서 연결하므로 내보내기에 “insecure” 옵션이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het exportpad leeg om de exports van de server weer te geven. Apple-apparaten maken verbinding vanaf een niet-geprivilegieerde poort, dus de export heeft de optie “insecure” nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o caminho de exportação vazio para listar as exportações do servidor. Os dispositivos Apple se conectam a partir de uma porta sem privilégios, então a exportação precisa da opção “insecure”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o caminho de exportação vazio para listar as exportações do servidor. Os dispositivos Apple ligam-se a partir de uma porta sem privilégios, por isso a exportação precisa da opção “insecure”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте путь экспорта пустым, чтобы увидеть экспорты сервера. Устройства Apple подключаются с непривилегированного порта, поэтому для экспорта нужен параметр «insecure»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna exportsökvägen tom för att visa serverns exporter. Apple-enheter ansluter från en oprivilegierad port, så exporten behöver alternativet ”insecure”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将导出路径留空以列出服务器的导出。Apple 设备从非特权端口连接，因此该导出需要“insecure”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將匯出路徑留空即可列出伺服器的匯出。Apple 裝置會從非特權埠連線，因此該匯出需要「insecure」選項。"
          }
        }
      }
    },
