    "Sources from %@ stop working on this Apple TV until you link the account again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen von %@ funktionieren auf diesem Apple TV nicht mehr, bis du den Account erneut verknüpfst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources from %@ stop working on this Apple TV until you link the account again."
          }
        },
