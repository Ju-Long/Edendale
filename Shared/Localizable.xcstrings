          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按一個方塊以開始選取。方塊越亮，表示當天上映或播出的影視作品越多。"
          }
        }
      }
    },
    "Tap the left or right side of the video twice to skip back or forward." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf die linke oder rechte Seite des Videos, um zurück- oder vorzuspringen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the left or right side of the video twice to skip back or forward."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the left or right side of the video twice to skip back or forward."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the left or right side of the video twice to skip back or forward."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the left or right side of the video twice to skip back or forward."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado izquierdo o derecho del vídeo para retroceder o avanzar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado izquierdo o derecho del video para retroceder o avanzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois le côté gauche ou droit de la vidéo pour reculer ou avancer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il lato sinistro o destro del video per tornare indietro o andare avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの左側または右側を2回タップすると、前後にスキップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 왼쪽 또는 오른쪽을 두 번 탭하여 뒤로 또는 앞으로 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer op de linker- of rechterkant van de video om terug of vooruit te springen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado esquerdo ou direito do vídeo para voltar ou avançar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado esquerdo ou direito do vídeo para recuar ou avançar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь левой или правой части видео, чтобы перемотать назад или вперед."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck två gånger på vänster eller höger sida av videon för att hoppa bakåt eller framåt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下视频的左侧或右侧可向后或向前跳转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按兩下影片的左側或右側即可倒轉或快轉。"
          }
        }
      }
    },
    "Tap the right side twice to jump forward %lld seconds, or the left side twice to jump back %lld seconds. Tap the middle twice to play or pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal auf die rechte Seite, um %1$lld Sekunden vorzuspringen, oder zweimal auf die linke Seite, um %2$lld Sekunden zurückzuspringen. Tippe zweimal auf die Mitte, um abzuspielen oder anzuhalten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the right side twice to jump forward %lld seconds, or the left side twice to jump back %lld seconds. Tap the middle twice to play or pause."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the right side twice to jump forward %lld seconds, or the left side twice to jump back %lld seconds. Tap the middle twice to play or pause."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the right side twice to jump forward %lld seconds, or the left side twice to jump back %lld seconds. Tap the middle twice to play or pause."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the right side twice to jump forward %lld seconds, or the left side twice to jump back %lld seconds. Tap the middle twice to play or pause."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado derecho para avanzar %1$lld segundos o dos veces el lado izquierdo para retroceder %2$lld segundos. Toca dos veces el centro para reproducir o pausar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces el lado derecho para avanzar %1$lld segundos o dos veces el lado izquierdo para retroceder %2$lld segundos. Toca dos veces el centro para reproducir o pausar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois le côté droit pour avancer de %1$lld secondes, ou deux fois le côté gauche pour reculer de %2$lld secondes. Touchez deux fois le centre pour lire ou mettre en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte il lato destro per andare avanti di %1$lld secondi o due volte il lato sinistro per tornare indietro di %2$lld secondi. Tocca due volte il centro per riprodurre o mettere in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側を2回タップすると%1$lld秒進み、左側を2回タップすると%2$lld秒戻ります。中央を2回タップすると再生/一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽을 두 번 탭하면 %1$lld초 앞으로, 왼쪽을 두 번 탭하면 %2$lld초 뒤로 이동합니다. 가운데를 두 번 탭하면 재생하거나 일시 정지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer op de rechterkant om %1$lld seconden vooruit te springen, of twee keer op de linkerkant om %2$lld seconden terug te springen. Tik twee keer in het midden om af te spelen of te pauzeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado direito para avançar %1$lld segundos ou duas vezes no lado esquerdo para voltar %2$lld segundos. Toque duas vezes no centro para reproduzir ou pausar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes no lado direito para avançar %1$lld segundos ou duas vezes no lado esquerdo para recuar %2$lld segundos. Toque duas vezes no centro para reproduzir ou pausar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь правой стороны, чтобы перемотать вперед на %1$lld с, или левой стороны, чтобы вернуться на %2$lld с. Дважды коснитесь середины, чтобы начать или приостановить воспроизведение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck två gånger på höger sida för att hoppa framåt %1$lld sekunder, eller två gånger på vänster sida för att hoppa bakåt %2$lld sekunder. Tryck två gånger i mitten för att spela upp eller pausa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点右侧两下可快进 %1$lld 秒，轻点左侧两下可快退 %2$lld 秒。轻点中间两下可播放或暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點右側兩下可快轉 %1$lld 秒，點左側兩下可倒轉 %2$lld 秒。點中間兩下可播放或暫停。"
          }
        }
      }
    },
    "Tap the video once to show or hide the controls. They fade away on their own after five seconds of playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe einmal auf das Video, um die Steuerung ein- oder auszublenden. Nach fünf Sekunden Wiedergabe blendet sie sich von selbst aus."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the video once to show or hide the controls. They fade away on their own after five seconds of playback."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the video once to show or hide the controls. They fade away on their own after five seconds of playback."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the video once to show or hide the controls. They fade away on their own after five seconds of playback."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the video once to show or hide the controls. They fade away on their own after five seconds of playback."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una vez el vídeo para mostrar u ocultar los controles. Desaparecen solos tras cinco segundos de reproducción."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una vez el video para mostrar u ocultar los controles. Desaparecen solos después de cinco segundos de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une fois la vidéo pour afficher ou masquer les commandes. Elles disparaissent d’elles-mêmes après cinq secondes de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una volta il video per mostrare o nascondere i controlli. Scompaiono da soli dopo cinque secondi di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを1回タップすると、コントロールの表示/非表示を切り替えます。再生が始まって5秒たつと自動的に消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 한 번 탭하면 제어기를 보거나 가릴 수 있습니다. 재생 중 5초가 지나면 자동으로 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik één keer op de video om de regelaars te tonen of te verbergen. Na vijf seconden afspelen verdwijnen ze vanzelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque uma vez no vídeo para mostrar ou ocultar os controles. Eles desaparecem sozinhos após cinco segundos de reprodução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque uma vez no vídeo para mostrar ou ocultar os controlos. Desaparecem sozinhos após cinco segundos de reprodução."
