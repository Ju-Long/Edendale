    "Applies to text subtitles. Image-based subtitles keep the look they were authored with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Textuntertitel. Bildbasierte Untertitel behalten ihr ursprüngliches Aussehen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to text subtitles. Image-based subtitles keep the look they were authored with."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to text subtitles. Image-based subtitles keep the look they were authored with."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to text subtitles. Image-based subtitles keep the look they were authored with."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to text subtitles. Image-based subtitles keep the look they were authored with."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los subtítulos de texto. Los subtítulos basados en imágenes conservan el aspecto con el que se crearon."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los subtítulos de texto. Los subtítulos basados en imágenes conservan el aspecto con el que se crearon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique aux sous-titres textuels. Les sous-titres sous forme d’images conservent leur apparence d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ai sottotitoli di testo. I sottotitoli basati su immagini mantengono l’aspetto originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト字幕に適用されます。画像ベースの字幕は作成時の見た目のままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 자막에 적용됩니다. 이미지 기반 자막은 제작된 모양을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor tekstondertitels. Ondertitels op basis van afbeeldingen behouden hun oorspronkelijke uiterlijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se às legendas de texto. Legendas baseadas em imagem mantêm a aparência original."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se às legendas de texto. As legendas baseadas em imagens mantêm o aspeto original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется к текстовым субтитрам. Субтитры в виде изображений сохраняют исходный вид."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller textundertexter. Bildbaserade undertexter behåller sitt ursprungliga utseende."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于文本字幕。基于图像的字幕会保留其原始外观。"
