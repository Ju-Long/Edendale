          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no lado esquerdo ou direito do vídeo para reproduzir nessa velocidade até soltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no lado esquerdo ou direito do vídeo para reproduzir a essa velocidade até soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведите пальцы и удерживайте их на левой или правой части видео, чтобы воспроизводить с этой скоростью, пока не отпустите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyp och håll på vänster eller höger sida av videon för att spela upp i den hastigheten tills du släpper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频的左侧或右侧捏合并保持，即可以该速度播放，直到你松开。"
