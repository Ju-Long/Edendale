          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta los dedos y mantenlos sobre el video; después, arrastra hacia los lados para moverte por la línea de tiempo. Sepáralos para saltar a ese momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez et maintenez la vidéo, puis faites glisser latéralement pour parcourir la chronologie. Relâchez pour accéder à ce moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica e tieni premuto sul video, poi trascina lateralmente per spostarti nella timeline. Rilascia per saltare a quel momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ上でピンチしたまま横にドラッグすると、タイムライン上を移動できます。指を離すとその位置にジャンプします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 핀치한 채로 옆으로 드래그하면 타임라인을 이동할 수 있습니다. 손을 떼면 해당 지점으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp en houd vast op de video en sleep dan zijwaarts om door de tijdlijn te bewegen. Laat los om naar dat moment te springen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no vídeo, depois arraste para os lados para percorrer a linha do tempo. Solte para ir para esse momento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça o gesto de pinça e mantenha no vídeo e, depois, arraste para os lados para percorrer a linha cronológica. Solte para saltar para esse momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сведите пальцы на видео и, удерживая их, перетащите в сторону, чтобы перемещаться по шкале времени. Отпустите, чтобы перейти к этому моменту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyp och håll på videon och dra sedan åt sidan för att röra dig längs tidslinjen. Släpp för att hoppa till det ögonblicket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频上捏合并保持，然后左右拖移即可在时间线中移动。松开即可跳到该位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
