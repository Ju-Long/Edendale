    "Press Play/Pause to pause or resume at any time. Back steps out one layer at a time: an open panel, then the controls, then the player." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke „Wiedergabe/Pause“, um jederzeit anzuhalten oder fortzufahren. „Zurück“ schließt eine Ebene nach der anderen: einen geöffneten Bereich, dann die Steuerung, dann den Player."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Play/Pause to pause or resume at any time. Back steps out one layer at a time: an open panel, then the controls, then the player."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Play/Pause to pause or resume at any time. Back steps out one layer at a time: an open panel, then the controls, then the player."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Play/Pause to pause or resume at any time. Back steps out one layer at a time: an open panel, then the controls, then the player."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Play/Pause to pause or resume at any time. Back steps out one layer at a time: an open panel, then the controls, then the player."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Reproducir/Pausa para pausar o reanudar en cualquier momento. Atrás cierra una capa cada vez: un panel abierto, luego los controles y después el reproductor."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona Reproducir/Pausa para pausar o reanudar en cualquier momento. Atrás cierra una capa a la vez: un panel abierto, luego los controles y después el reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Lecture/Pause pour mettre en pause ou reprendre à tout moment. Retour ferme un niveau à la fois : un panneau ouvert, puis les commandes, puis le lecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi Play/Pausa per mettere in pausa o riprendere in qualsiasi momento. Indietro chiude un livello alla volta: un pannello aperto, poi i controlli, poi il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再生/一時停止」を押すと、いつでも一時停止または再開できます。「戻る」を押すたびに、開いているパネル、コントロール、プレーヤーの順に閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생/일시 정지 버튼을 눌러 언제든지 일시 정지하거나 다시 재생할 수 있습니다. 뒤로 버튼을 누를 때마다 열린 패널, 제어기, 플레이어 순으로 닫힙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op Afspelen/pauzeer om op elk moment te pauzeren of verder te gaan. Terug sluit één laag tegelijk: een open paneel, dan de regelaars, dan de speler."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione Reproduzir/Pausar para pausar ou retomar a qualquer momento. Voltar fecha uma camada por vez: um painel aberto, depois os controles e, por fim, o reprodutor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima Reproduzir/Pausar para pausar ou retomar a qualquer momento. Voltar fecha uma camada de cada vez: um painel aberto, depois os controlos e, por fim, o leitor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Воспроизведение/пауза», чтобы в любой момент приостановить или возобновить просмотр. «Назад» закрывает по одному слою: открытую панель, затем элементы управления, затем плеер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Spela/Paus för att pausa eller fortsätta när som helst. Bakåt stänger ett lager i taget: en öppen panel, sedan reglagen och sist spelaren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下“播放/暂停”可随时暂停或继续播放。每按一次“返回”会依次关闭一层：打开的面板、控制，最后是播放器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下「播放/暫停」可隨時暫停或繼續播放。每按一次「返回」會依序關閉一層：打開的面板、控制項目，最後是播放器。"
          }
        }
      }
    },
