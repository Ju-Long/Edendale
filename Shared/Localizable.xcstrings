    "Leave both empty to connect as guest. The password is stored only in your Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass beide leer, um dich als Gast zu verbinden. Das Passwort wird nur in deinem Schlüsselbund gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave both empty to connect as guest. The password is stored only in your Keychain."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja ambos en blanco para conectar como invitado. La contraseña solo se guarda en el llavero."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja ambos en blanco para conectarte como invitado. La contraseña solo se guarda en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez les deux champs vides pour vous connecter en tant qu'invité. Le mot de passe est stocké uniquement dans votre trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia entrambi i campi vuoti per connetterti come ospite. La password viene archiviata solo nel portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストとして接続するには両方を空にしてください。パスワードはキーチェーンにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트로 연결하려면 둘 다 비워 두십시오. 암호는 키체인에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat beide leeg om als gast te verbinden. Het wachtwoord wordt alleen in je sleutelhanger bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ambos vazios para conectar como convidado. A senha é armazenada apenas nas suas Chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ambos os campos vazios para ligar como convidado. A palavra-passe é guardada apenas no seu porta-chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте оба поля пустыми для гостевого входа. Пароль надежно хранится в Связке ключей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna båda tomma för att ansluta som gäst. Lösenordet sparas endast i din nyckelring."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空以访客身份连接。密码仅存储在你的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將兩者留空即可作為訪客連線。密碼僅會儲存在你的鑰匙圈中。"
          }
        }
      }
    },
