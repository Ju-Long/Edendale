          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce una película o episodio local coincidente, o abre la búsqueda cuando no coincide ningún archivo local."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce una película o episodio local coincidente, o abre la búsqueda cuando no coincide ningún archivo local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit un film ou un épisode local correspondant, ou ouvre la recherche si aucun fichier local ne correspond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un film o un episodio locale corrispondente, o apre la ricerca se nessun file locale corrisponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するローカルの映画またはエピソードを再生するか、一致するローカルファイルがない場合は検索を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 로컬 영화나 에피소드를 재생하거나, 일치하는 로컬 파일이 없으면 검색을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een overeenkomende lokale film of aflevering af, of opent zoeken wanneer er geen lokaal bestand overeenkomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um filme ou episódio local correspondente, ou abre a busca quando nenhum arquivo local corresponde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um filme ou episódio local correspondente, ou abre a pesquisa quando não há nenhum ficheiro local correspondente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит подходящий локальный фильм или эпизод, либо открывает поиск, если совпадений нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar en matchande lokal film eller ett avsnitt, eller öppnar sökningen om ingen lokal fil matchar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放匹配的本地电影或单集，如果本地没有匹配的文件，则打开搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放相符的本機電影或劇集，或者在沒有相符的本機檔案時打開搜尋。"
          }
        }
      }
    },
    "Plays at this speed while you click and hold the left half of the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt mit dieser Geschwindigkeit wieder, solange du auf die linke Hälfte des Videos klickst und die Maustaste gedrückt hältst."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays at this speed while you click and hold the left half of the video."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays at this speed while you click and hold the left half of the video."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays at this speed while you click and hold the left half of the video."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays at this speed while you click and hold the left half of the video."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce a esta velocidad mientras mantienes pulsada la mitad izquierda del vídeo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce a esta velocidad mientras mantienes presionada la mitad izquierda del video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit à cette vitesse tant que vous maintenez le clic sur la moitié gauche de la vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce a questa velocità mentre tieni premuto il clic sulla metà sinistra del video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの左半分をクリックしたままにしている間、この速度で再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오의 왼쪽 절반을 클릭한 채로 있는 동안 이 속도로 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt af op deze snelheid zolang je de linkerhelft van de video ingedrukt houdt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz nessa velocidade enquanto você mantém o clique na metade esquerda do vídeo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz a esta velocidade enquanto mantém o clique na metade esquerda do vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит с этой скоростью, пока вы нажимаете и удерживаете левую половину видео."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar upp i den här hastigheten medan du klickar och håller på videons vänstra halva."
          }
        },
        "zh-Hans" : {
