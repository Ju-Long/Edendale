---
import { DEFAULT_LOCALE, useTranslations, type UIKey } from "../i18n/utils.ts";

interface Props {
  headingKey?: UIKey;
}

const { headingKey = "link.heading" } = Astro.props;

// App-link pages live on one unprefixed URL each, so they are rendered in the
// default language and re-labelled in the browser by SiteLayout's script.
const t = useTranslations(DEFAULT_LOCALE);
---

<section class="link-page section-shell" aria-labelledby="link-title">
  <div class="link-card">
    <p class="eyebrow"><span></span> <span data-i18n="link.eyebrow">{t("link.eyebrow")}</span></p>
    <h1 id="link-title" data-i18n={headingKey}>{t(headingKey)}</h1>
    <p data-i18n="link.body">{t("link.body")}</p>
    <div class="button-row">
      <a class="button button-primary" href="#" data-open-app hidden>
        <span data-i18n="link.open">{t("link.open")}</span>
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
      <a class="button button-secondary" href={import.meta.env.BASE_URL} data-locale-home>
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <span data-i18n="link.visit">{t("link.visit")}</span>
      </a>
    </div>
    <p class="link-detail" data-link-detail data-i18n="link.unavailable">
      {t("link.unavailable")}
    </p>
  </div>
</section>

<script>
  const appButton = document.querySelector<HTMLAnchorElement>("[data-open-app]");
  const linkDetail = document.querySelector<HTMLElement>("[data-link-detail]");
  const base = import.meta.env.BASE_URL.replace(/^\/+|\/+$/g, "");
  let route = window.location.pathname.replace(/^\/+|\/+$/g, "");
  if (base && route.startsWith(`${base}/`)) route = route.slice(base.length + 1);

  const uuid =
    "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}";
  const query = new URLSearchParams(window.location.search).get("q")?.trim();
  const isAppRoute =
    (route === "search" && Boolean(query)) ||
    /^media\/(?:movie|tv)\/\d+$/.test(route) ||
    new RegExp(`^library/(?:movie|show)/${uuid}$`).test(route) ||
    /^play\/(?:movie|episode)\/\d+$/.test(route) ||
    new RegExp(`^play/(?:local-movie|local-episode)/${uuid}$`).test(route);

  if (appButton && linkDetail && isAppRoute) {
    appButton.href = `edendale://${route}${window.location.search}`;
    appButton.hidden = false;
    // The layout's inline language script has already run by the time this
    // module executes, so its resolved strings are the right source for the
    // note that replaces `link.unavailable` here.
    linkDetail.removeAttribute("data-i18n");
    linkDetail.textContent =
      window.__edendaleStrings?.["link.explicit"] ??
      "The app opens only after you choose Open in Edendale.";
  }
</script>
