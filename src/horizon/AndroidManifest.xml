<?xml version="1.0" encoding="utf-8"?>
<!-- The Horizon OS overlay (HORIZON.md A.2), merged over src/main's manifest.
     Meta's packaging rules ask for installLocation, the supported-devices
     tag, and nothing a headset lacks; the TV-only entries (Watch Next's EPG
     permission, Leanback, the TV launcher and its banner) come out here, so
     src/main stays as the android branch has it and merges from android stay
     clean. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- Only a TV has the provider that grants it. -->
    <uses-permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:node="remove" />
    <!-- media3-exoplayer declares it, and Meta reviews it. Edendale never sets
         a wake mode; the player keeps the panel on with FLAG_KEEP_SCREEN_ON. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />
    <!-- WorkManager (27.1 sync's background job) declares it, and Meta
         reviews it. It only re-registers the job after a reboot; WorkManager
         also does that whenever the app starts, and the app syncs on launch.
         WorkManager takes a wake lock only for foreground work, which sync
         doesn't use, or in its pre-API-23 alarm scheduler. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <!-- B.15: a Quest 3 or 3S scans the other device's pairing code with its
         passthrough camera (Meta's Passthrough Camera API, Horizon OS v74 and
         later), which needs android's CAMERA and Meta's HEADSET_CAMERA, both
         asked for only when the viewer chooses to scan; frames are read on
         the headset and never kept or sent. Meta reviews both, so the
         submission justifies them (HORIZON.md B.15). Meta's upload refuses
         HEADSET_CAMERA while the device list names a headset without the
         passthrough camera, so the app supports the Quest 3 and 3S only (D4,
         verifyHorizonRelease). android's three optional
         camera features still come out, as in B.14: they are
         required="false" and say nothing about a headset's cameras. -->
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        tools:node="remove" />
    <uses-feature
        android:name="android.software.leanback"
        tools:node="remove" />
    <!-- Meta's marker for an app that runs on its headsets as a 2D panel. It
         stays optional with the theater (G.4, src/horizonTheater): the panel
         app installs and runs as before, and the theater is an extra activity. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false"
        android:version="1" />

    <application tools:remove="android:banner">
        <!-- D4 (owner, 2026-11-13): the Quest 3 and 3S, the headsets with the
             passthrough camera the pairing scanner needs (B.15). Meta's upload
             refused HEADSET_CAMERA while the list also named quest2 and questpro.
             Findings records what each headset was tested on. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|quest3s" />

        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- B.3: Horizon OS reports the PiP feature on the simulator but pins
             the window at nearly panel size (Findings, 2026-10-10), and the
             Quest 3 doesn't report it at all. DevicePolicy hides the button
             and the Auto PiP setting; this keeps the system from trying. -->
        <activity
            android:name=".player.PlayerActivity"
            android:supportsPictureInPicture="false"
            tools:replace="android:supportsPictureInPicture" />
    </application>

</manifest>
