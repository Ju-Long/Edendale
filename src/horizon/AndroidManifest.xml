<?xml version="1.0" encoding="utf-8"?>
<!-- The Horizon OS overlay (HORIZON.md A.2), merged over src/main's manifest.
     Meta's packaging rules ask for installLocation, the supported-devices
     tag, and nothing a headset lacks; the TV-only entries (Watch Next's EPG
     permission, Leanback, the TV launcher and its banner) come out here, so
     src/main stays as the android branch has it and merges from android stay
     clean. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- Only a TV has the provider that grants it. -->
    <uses-permission
        android:name="com.android.providers.tv.permission.WRITE_EPG_DATA"
        tools:node="remove" />
    <!-- media3-exoplayer declares it, and Meta reviews it. Edendale never sets
         a wake mode; the player keeps the panel on with FLAG_KEEP_SCREEN_ON. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <uses-feature
        android:name="android.software.leanback"
        tools:node="remove" />
    <!-- Meta's marker for an app that runs on its headsets as a 2D panel. It
         stays optional with the theater (G.4): the panel app installs and runs
         as before, and the theater is an extra activity. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false"
        android:version="1" />

    <!-- G.4: the immersive theater (Section G) uses the Spatial SDK. Without
         this declaration Horizon OS logs that the app retrieves an HzOS SDK
         manager without a minimum version and "must fix this to continue"
         (Findings, 2026-10-25). -->
    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />
    <!-- Hands and controllers both drive the theater (Input.7). Without the
         feature and permission, vrshell's "controllers required" launch check
         blocks the theater while the controllers are asleep (Findings,
         2026-10-25). The permission is on neither of Meta's lists in gradle/. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <application tools:remove="android:banner">
        <!-- D4. Quest 2 and Pro have no AV1 hardware decoder and the app has no
             software one; Findings records what each headset was tested on. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <!-- G.4: hand tracking's API version, as Meta's hybrid sample declares it. -->
        <meta-data
            android:name="com.oculus.handtracking.version"
            android:value="V2.0" />
        <!-- The Spatial SDK's runtime library on the headset; optional so the
             manifest still installs where it's absent (the simulator, phones). -->
        <uses-native-library
            android:name="libossdk.oculus.so"
            android:required="false" />

        <!-- G.4–G.6: the immersive theater, opened only from the player's
             Theater button (G.5) with an explicit intent. The VR category tells
             Horizon OS to run it immersively rather than in a panel; MAIN
             without LAUNCHER adds no icon, so the library still opens the
             panel. singleTask, the fullscreen theme, and the configuration
             changes follow Meta's hybrid sample. Exported, as in the sample;
             G.10 checks whether exported="false" also works. -->
        <activity
            android:name=".theater.TheaterActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- B.3: Horizon OS reports the PiP feature on the simulator but pins
             the window at nearly panel size (Findings, 2026-10-10), and the
             Quest 3 doesn't report it at all. DevicePolicy hides the button
             and the Auto PiP setting; this keeps the system from trying. -->
        <activity
            android:name=".player.PlayerActivity"
            android:supportsPictureInPicture="false"
            tools:replace="android:supportsPictureInPicture" />
    </application>

</manifest>
