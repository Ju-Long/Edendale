---
import LinkLanding from "../components/LinkLanding.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

export function getStaticPaths() {
  return ["search", "media", "library", "play"].map((route) => ({
    params: { route },
  }));
}
---

<SiteLayout
  title="Open in Edendale"
  description="Continue this link in the Edendale app."
  noIndex
>
  <main><LinkLanding /></main>
</SiteLayout>
