---
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  lines,
  LOCALES,
  pageUrl,
  useTranslations,
  type LocalePath,
  type UIKey,
} from "../../i18n/utils.ts";

/**
 * One source file, one page per language, plus the automatic entry point.
 *
 * - `/` serves English and redirects a visitor whose browser asks for another
 *   language to that language, the way apple.com routes to `/jp/` or `/de/`.
 * - `/en/` serves the same English page without redirecting, so choosing
 *   English from the picker is a URL and not a stored preference.
 * - `/es/`, `/ja/`, … serve their language directly.
 */
export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: "en" as LocalePath, automatic: true } },
    ...LOCALES.map((entry) => ({
      params: { locale: entry.path },
      props: { locale: entry.path as LocalePath, automatic: false },
    })),
  ];
}

const { locale, automatic } = Astro.props;
const t = useTranslations(locale);

// Headings carry their own line breaks so each language can wrap where its
// words allow. The hero highlights its middle line in gold.
const heroTitle = lines(t("hero.title"));
const heroAccent = heroTitle.length > 2 ? 1 : -1;
const featuresTitle = lines(t("features.title"));
const sourcesTitle = lines(t("sources.title"));
const playerTitle = lines(t("player.title"));
const platformsTitle = lines(t("platforms.title"));
const closingTitle = lines(t("closing.title"));

// Protocol and provider names are never translated.
const networkSources = ["SMB", "NFS", "SFTP", "WebDAV"];
const cloudSources = ["Google Drive", "OneDrive", "Dropbox", "S3"];

const playerFeatures: readonly { icon: string; title: UIKey; body: UIKey }[] = [
  { icon: "fa-forward", title: "player.skipTitle", body: "player.skipBody" },
  { icon: "fa-forward-step", title: "player.nextTitle", body: "player.nextBody" },
  { icon: "fa-sliders", title: "player.soundTitle", body: "player.soundBody" },
  { icon: "fa-wand-magic-sparkles", title: "player.pictureTitle", body: "player.pictureBody" },
  { icon: "fa-closed-captioning", title: "player.subtitlesTitle", body: "player.subtitlesBody" },
  { icon: "fa-hand-pointer", title: "player.controlsTitle", body: "player.controlsBody" },
];
---

<SiteLayout
  titleKey="meta.home.title"
  descriptionKey="meta.home.description"
  locale={locale}
  localeMode={automatic ? "auto" : "static"}
>
  <main>
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> {t("hero.eyebrow")}</p>
        <h1 id="hero-title">
          {heroTitle.map((line, index) => (
            <Fragment>
              {index > 0 && <br />}
              {index === heroAccent ? <em>{line}</em> : line}
            </Fragment>
          ))}
        </h1>
        <p class="hero-lede">{t("hero.lede")}</p>
        <div class="button-row">
          <a class="button button-primary" href="https://github.com/Ju-Long/Edendale">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            {t("hero.ctaSource")}
            <i class="fa-solid fa-arrow-up-right-from-square icon-external" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="#platforms">
            {t("hero.ctaExplore")}
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </a>
        </div>
        <ul class="trust-list" aria-label={t("hero.trustAria")}>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> {t("hero.trustLocal")}</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> {t("hero.trustAnalytics")}</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> {t("hero.trustOpenSource")}</li>
        </ul>
      </div>

      <div class="hero-visual" aria-label={t("hero.visualAria")}>
        <div class="projector-glow"></div>
        <div class="archive-window">
          <div class="window-bar">
            <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <p>{t("hero.windowTitle")}</p>
            <span class="window-status">{t("hero.windowStatus")}</span>
          </div>
          <div class="window-body">
            <div class="window-heading">
              <span>{t("hero.windowResume")}</span>
              <strong>{t("hero.windowMoment")}</strong>
            </div>
            <div class="feature-frame">
              <div class="film-mark" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>
              <div class="feature-caption">
                <p>{t("hero.windowNowPlaying")}</p>
                <strong>{t("hero.windowPickUp")}</strong>
                <div class="progress-track"><span></span></div>
              </div>
            </div>
            <div class="poster-row" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>
        <div class="privacy-note">
          <span class="privacy-pulse" aria-hidden="true"></span>
          <div>
            <strong>{t("hero.privacyTitle")}</strong>
            <small>{t("hero.privacyBody")}</small>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label={t("proof.aria")}>
      <div class="section-shell proof-grid">
        <p><strong>{t("proof.archiveTitle")}</strong><span>{t("proof.archiveBody")}</span></p>
        <p><strong>{t("proof.playbackTitle")}</strong><span>{t("proof.playbackBody")}</span></p>
        <p><strong>{t("proof.cloudTitle")}</strong><span>{t("proof.cloudBody")}</span></p>
        <p><strong>{t("proof.telemetryTitle")}</strong><span>{t("proof.telemetryBody")}</span></p>
      </div>
    </section>

    <section class="section-shell feature-section" id="features" aria-labelledby="features-title">
      <div class="section-intro">
        <p class="eyebrow"><span></span> {t("features.eyebrow")}</p>
        <h2 id="features-title">
          {featuresTitle.map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
        <p>{t("features.lede")}</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card feature-card-wide">
          <span class="feature-number">01</span>
          <div class="card-art card-art-library" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h3>{t("features.libraryTitle")}</h3>
          <p>{t("features.libraryBody")}</p>
        </article>
        <article class="feature-card">
          <span class="feature-number">02</span>
          <div class="card-art card-art-progress" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h3>{t("features.progressTitle")}</h3>
          <p>{t("features.progressBody")}</p>
        </article>
        <article class="feature-card">
          <span class="feature-number">03</span>
          <div class="card-art card-art-private" aria-hidden="true">
            <span></span>
          </div>
          <h3>{t("features.privacyTitle")}</h3>
          <p>{t("features.privacyBody")}</p>
        </article>
      </div>
    </section>

    <section class="sources-section" id="sources" aria-labelledby="sources-title">
      <div class="section-shell">
        <div class="section-intro">
          <p class="eyebrow"><span></span> {t("sources.eyebrow")}</p>
          <h2 id="sources-title">
            {sourcesTitle.map((line, index) => (
              <Fragment>{index > 0 && <br />}{line}</Fragment>
            ))}
          </h2>
          <p>{t("sources.lede")}</p>
        </div>
        <div class="source-grid">
          <article class="source-card">
            <span class="source-icon" aria-hidden="true">
              <i class="fa-solid fa-hard-drive"></i>
            </span>
            <h3>{t("sources.deviceTitle")}</h3>
            <p>{t("sources.deviceBody")}</p>
            <ul class="source-names">
              <li>{t("sources.deviceFolders")}</li>
              <li>{t("sources.deviceDrives")}</li>
            </ul>
          </article>
          <article class="source-card">
            <span class="source-icon" aria-hidden="true">
              <i class="fa-solid fa-server"></i>
            </span>
            <h3>{t("sources.networkTitle")}</h3>
            <p>{t("sources.networkBody")}</p>
            <ul class="source-names">
              {networkSources.map((name) => <li>{name}</li>)}
            </ul>
          </article>
          <article class="source-card">
            <span class="source-icon" aria-hidden="true">
              <i class="fa-solid fa-cloud"></i>
            </span>
            <h3>{t("sources.cloudTitle")}</h3>
            <p>{t("sources.cloudBody")}</p>
            <ul class="source-names">
              {cloudSources.map((name) => <li>{name}</li>)}
            </ul>
          </article>
        </div>
        <div class="source-access">
          <span class="source-icon" aria-hidden="true">
            <i class="fa-solid fa-lock"></i>
          </span>
          <div>
            <h3>{t("sources.accessTitle")}</h3>
            <p>{t("sources.accessBody")}</p>
          </div>
          <a class="button button-secondary" href={pageUrl(locale, "privacy")}>
            {t("sources.accessLink")}
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
        <p class="source-footnote">{t("sources.availability")}</p>
      </div>
    </section>

    <section class="section-shell player-section" id="player" aria-labelledby="player-title">
      <div class="section-intro">
        <p class="eyebrow"><span></span> {t("player.eyebrow")}</p>
        <h2 id="player-title">
          {playerTitle.map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
        <p>{t("player.lede")}</p>
      </div>
      <div class="player-grid">
        {
          playerFeatures.map((feature) => (
            <article class="player-card">
              <span class="source-icon" aria-hidden="true">
                <i class={`fa-solid ${feature.icon}`}></i>
              </span>
              <h3>{t(feature.title)}</h3>
              <p>{t(feature.body)}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="native-section" id="platforms" aria-labelledby="platforms-title">
      <div class="section-shell native-grid">
        <div class="section-intro">
          <p class="eyebrow"><span></span> {t("platforms.eyebrow")}</p>
          <h2 id="platforms-title">
            {platformsTitle.map((line, index) => (
              <Fragment>{index > 0 && <br />}{line}</Fragment>
            ))}
          </h2>
          <p>{t("platforms.lede")}</p>
        </div>
        <div class="platform-list">
          <article>
            <span class="platform-monogram" aria-hidden="true">
              <i class="fa-brands fa-apple"></i>
            </span>
            <div><h3>Apple</h3><p>{t("platforms.appleDevices")}</p></div>
            <span class="platform-tech">SwiftUI</span>
          </article>
          <article>
            <span class="platform-monogram" aria-hidden="true">
              <i class="fa-brands fa-android"></i>
            </span>
            <div><h3>Android</h3><p>{t("platforms.androidDevices")}</p></div>
            <span class="platform-tech">Jetpack Compose</span>
          </article>
          <article>
            <span class="platform-monogram" aria-hidden="true">
              <i class="fa-brands fa-windows"></i>
            </span>
            <div><h3>Windows</h3><p>{t("platforms.windowsDevices")}</p></div>
            <span class="platform-tech">C# · WinUI</span>
          </article>
        </div>
      </div>
    </section>

    <section class="section-shell closing-section" aria-labelledby="closing-title">
      <div>
        <p class="eyebrow"><span></span> {t("closing.eyebrow")}</p>
        <h2 id="closing-title">
          {closingTitle.map((line, index) => (
            <Fragment>{index > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
      </div>
      <div class="closing-action">
        <p>{t("closing.body")}</p>
        <a class="button button-primary" href="https://github.com/Ju-Long/Edendale">
          {t("closing.cta")}
          <i class="fa-solid fa-arrow-up-right-from-square icon-external" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
