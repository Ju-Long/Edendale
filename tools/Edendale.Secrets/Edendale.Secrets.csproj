<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool that writes the gitignored root secrets.json the local build
    embeds. It is not part of the shipping app and nothing in the app
    references it; it exists so setting up credentials needs no PowerShell
    execution-policy exception and no hand-edited JSON.

    Run it from the repository root with "dotnet run" against this project.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the file is protected with a Windows owner-only ACL. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64' and '$(Platform)' != 'x64'">AnyCPU</PlatformTarget>
    <RootNamespace>Edendale.Secrets</RootNamespace>
    <AssemblyName>Edendale.Secrets</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Console.ReadKey is the whole point; never launch a window. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

</Project>
