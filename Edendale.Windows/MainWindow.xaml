<Window
    x:Class="Edendale.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    Title="Edendale">

    <Grid RequestedTheme="Dark" Background="{StaticResource EdendaleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: wordmark on the sidebar surface. -->
        <Grid
            x:Name="AppTitleBar"
            Background="{StaticResource EdendaleSurfaceLowBrush}">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                Spacing="10">
                <TextBlock
                    x:Uid="BrandWordmark"
                    Text="EDENDALE"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="22"
                    CharacterSpacing="400"
                    Foreground="{StaticResource EdendaleGoldBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle
                Height="1"
                Fill="{StaticResource EdendaleHairlineBorderBrush}"
                VerticalAlignment="Bottom" />
        </Grid>

        <!-- Shell: fixed dim sidebar + content canvas (the macOS shell). -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged"
            ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <!-- Icons are Font Awesome SVGs; PathIcon geometry is
                     assigned in code (SvgIcon.CreateIcon). -->
                <NavigationViewItem x:Uid="MoviesNavItem" x:Name="MoviesNavItem" Content="Movies &amp; Shows" Tag="movies" IsSelected="True" />
                <!-- Only surfaced once the watchlist has a visible item
                     (RootView.hasWatchlistItems parity). -->
                <NavigationViewItem x:Uid="WatchlistNavItem" x:Name="WatchlistNavItem" Content="Watchlist" Tag="watchlist" Visibility="Collapsed" IsExpanded="True">
                    <!-- Section rows (DIFF.md §3.15): each shows only while
                         its section has titles for the current audience. -->
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="WatchlistMoviesNavItem" x:Name="WatchlistMoviesNavItem" Content="Movies" Tag="watchlist:movies" Visibility="Collapsed" />
                        <NavigationViewItem x:Uid="WatchlistShowsNavItem" x:Name="WatchlistShowsNavItem" Content="TV Shows" Tag="watchlist:shows" Visibility="Collapsed" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="DownloadedNavItem" x:Name="DownloadedNavItem" Content="Downloaded" Tag="downloaded" IsExpanded="True">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="DownloadedContinueNavItem" x:Name="DownloadedContinueNavItem" Content="Continue Watching" Tag="downloaded:continue" Visibility="Collapsed" />
                        <NavigationViewItem x:Uid="DownloadedMoviesNavItem" x:Name="DownloadedMoviesNavItem" Content="Movies" Tag="downloaded:movies" Visibility="Collapsed" />
                        <NavigationViewItem x:Uid="DownloadedShowsNavItem" x:Name="DownloadedShowsNavItem" Content="TV Shows" Tag="downloaded:shows" Visibility="Collapsed" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="SearchNavItem" x:Name="SearchNavItem" Content="Search" Tag="search" />
            </NavigationView.MenuItems>
            <Frame x:Name="RootFrame" Background="{StaticResource EdendaleBackgroundBrush}" />
        </NavigationView>

        <!-- Full-window, black-first LibVLC player (DESIGN.md). Edendale's
             XAML chrome remains above VLC's Direct3D swap chain. In Picture in
             Picture the whole window becomes a compact overlay; full screen
             swaps the presenter. The playlist and Player Adjustments dock as
             a trailing inline pane that narrows the video instead of
             covering it (DIFF.md §3.15). -->
        <Grid
            x:Name="PlayerOverlay"
            Grid.RowSpan="2"
            Background="Black"
            Visibility="Collapsed"
            KeyDown="PlayerOverlay_KeyDown">
            <SplitView
                x:Name="PlayerSplit"
                DisplayMode="Inline"
                PanePlacement="Right"
                OpenPaneLength="380"
                IsPaneOpen="False"
                PaneBackground="{StaticResource EdendaleSurfaceLowBrush}">
                <SplitView.Pane>
                    <Grid x:Name="PlayerPaneHost" BorderBrush="{StaticResource EdendaleHairlineBorderBrush}" BorderThickness="1,0,0,0">
                        <controls:PlayerPlaylistPanel
                            x:Name="PlaylistPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            CloseRequested="PlayerPanel_CloseRequested"
                            PlayRequested="PlaylistPanel_PlayRequested" />
                        <controls:PlayerAdjustmentsPanel
                            x:Name="AdjustmentsPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            CloseRequested="PlayerPanel_CloseRequested"
                            AspectFillChanged="AdjustmentsPanel_AspectFillChanged"
                            RateChangeRequested="AdjustmentsPanel_RateChangeRequested"
                            EngineReopenRequested="AdjustmentsPanel_EngineReopenRequested" />
                    </Grid>
                </SplitView.Pane>

                <Grid x:Name="VideoHost" Background="Black">
                    <vlc:VideoView
                        x:Name="PlayerElement"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Initialized="PlayerElement_Initialized"
                        SizeChanged="PlayerElement_SizeChanged" />

                    <!-- F.3: a brief state while LibVLC reopens at the same
                         position, instead of a bare black frame. -->
                    <Grid x:Name="ApplyingLayer" Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="28" Height="28" Foreground="{StaticResource EdendaleGoldBrush}" />
                            <TextBlock
                                x:Uid="PlayerApplyingText"
                                Text="Applying…"
                                Style="{StaticResource BodySMTextStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>

                    <controls:PlayerControlsOverlay
                        x:Name="ControlsOverlay"
                        CloseRequested="ClosePlayer_Click"
                        PlaylistRequested="ControlsOverlay_PlaylistRequested"
                        AdjustmentsRequested="ControlsOverlay_AdjustmentsRequested"
                        PictureInPictureRequested="ControlsOverlay_PictureInPictureRequested"
                        FullScreenRequested="ControlsOverlay_FullScreenRequested"
                        PlayNextRequested="ControlsOverlay_PlayNextRequested"
                        BaseRateChanged="ControlsOverlay_BaseRateChanged"
                        EndReachedBySkip="ControlsOverlay_EndReachedBySkip" />
                </Grid>
            </SplitView>
        </Grid>

        <!-- Feedback for rejected external links / unsupported files. Sits
             above the player so messages raised during playback are seen. -->
        <InfoBar
            x:Name="ActivationBar"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            Severity="Warning"
            IsOpen="False" />
    </Grid>
</Window>
