<Window
    x:Class="Edendale.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    Title="Edendale">

    <Grid RequestedTheme="Dark" Background="{StaticResource EdendaleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: wordmark on the sidebar surface. -->
        <Grid
            x:Name="AppTitleBar"
            Background="{StaticResource EdendaleSurfaceLowBrush}">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0"
                Spacing="10">
                <TextBlock
                    Text="EDENDALE"
                    FontFamily="{StaticResource DisplayFontFamily}"
                    FontSize="22"
                    CharacterSpacing="400"
                    Foreground="{StaticResource EdendaleGoldBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle
                Height="1"
                Fill="{StaticResource EdendaleHairlineBorderBrush}"
                VerticalAlignment="Bottom" />
        </Grid>

        <!-- Shell: fixed dim sidebar + content canvas (the macOS shell). -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <!-- Icons are Font Awesome SVGs; PathIcon geometry is
                     assigned in code (SvgIcon.CreateIcon). -->
                <NavigationViewItem x:Name="MoviesNavItem" Content="Movies &amp; Shows" Tag="movies" IsSelected="True" />
                <NavigationViewItem x:Name="DownloadedNavItem" Content="Downloaded" Tag="downloaded" />
                <NavigationViewItem x:Name="SearchNavItem" Content="Search" Tag="search" />
            </NavigationView.MenuItems>
            <Frame x:Name="RootFrame" Background="{StaticResource EdendaleBackgroundBrush}" />
        </NavigationView>

        <!-- Full-window, black-first player (DESIGN.md). Chrome is the
             MediaPlayerElement's transport controls plus a top scrim with
             title and close. In Picture in Picture the whole window becomes a
             compact overlay and the chrome steps aside for the video. -->
        <Grid
            x:Name="PlayerOverlay"
            Grid.RowSpan="2"
            Background="Black"
            Visibility="Collapsed"
            KeyDown="PlayerOverlay_KeyDown"
            DoubleTapped="PlayerOverlay_DoubleTapped">
            <MediaPlayerElement
                x:Name="PlayerElement"
                AreTransportControlsEnabled="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <controls:PlayerControlsOverlay
                x:Name="ControlsOverlay"
                CloseRequested="ClosePlayer_Click"
                PlaylistRequested="ControlsOverlay_PlaylistRequested"
                AspectFillChanged="ControlsOverlay_AspectFillChanged"
                PictureInPictureRequested="ControlsOverlay_PictureInPictureRequested" />

            <controls:PlayerPlaylistPanel
                x:Name="PlaylistPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                CloseRequested="PlaylistPanel_CloseRequested"
                PlayRequested="PlaylistPanel_PlayRequested" />
        </Grid>

        <!-- Feedback for rejected external links / unsupported files. Sits
             above the player so messages raised during playback are seen. -->
        <InfoBar
            x:Name="ActivationBar"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            Severity="Warning"
            IsOpen="False" />
    </Grid>
</Window>
