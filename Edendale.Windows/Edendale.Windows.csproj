<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Edendale.Windows</RootNamespace>
    <AssemblyName>Edendale</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged during development: run/debug without MSIX packaging or a certificate. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ship the Windows App SDK runtime with the app so no separate runtime install is needed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Base language for MRT Core: every lookup falls back here when the
         user's preferred language has no Strings/<lang>/Resources.resw. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Program.cs owns Main for the single-instance activation redirect. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- DPAPI protection for the stored TMDB session (TmdbAccountService). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Legacy code pages for subtitle files, which are rarely UTF-8. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Local credentials remain gitignored and are embedded only in local binaries.
       The same file is exposed under a second name for the services that are
       not TMDB (Wyzie Subs); each reads only the keys it owns. -->
  <ItemGroup Condition="Exists('..\secrets.json')">
    <EmbeddedResource Include="..\secrets.json" LogicalName="Edendale.TmdbSecrets" />
    <EmbeddedResource Include="..\secrets.json" LogicalName="Edendale.LocalSecrets" />
  </ItemGroup>
</Project>
