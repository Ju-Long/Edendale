<UserControl
    x:Class="Edendale.Windows.Controls.SkipPromptsSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SKIP PROMPTS (SegmentSkippingSection.swift): an opt-in network
         feature, off by default. The copy says what leaves the device. -->
    <StackPanel>
        <TextBlock x:Uid="SettingsSkipPromptsHeader" Text="SKIP PROMPTS" Style="{StaticResource SettingsSectionHeaderTextStyle}" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
            <StackPanel>
                <Grid Style="{StaticResource SettingsRowGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsSkipPromptsLabel"
                        Text="Offer Skip Intro, Recap, and Credits"
                        Style="{StaticResource SettingsRowLabelTextStyle}"
                        Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Uid="SettingsSkipPromptsToggle"
                        x:Name="PromptsToggle"
                        Grid.Column="1"
                        OnContent=""
                        OffContent=""
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Skip prompts"
                        Toggled="PromptsToggle_Toggled" />
                </Grid>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                <TextBlock
                    x:Uid="SettingsSkipPromptsPrivacy"
                    Text="When enabled, TheIntroDB receives the title’s TMDB ID, episode numbers, video duration, and your IP address. Skipping always requires a button press."
                    Style="{StaticResource SettingsBodyRowTextStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
