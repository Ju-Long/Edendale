<UserControl
    x:Class="Edendale.Windows.Controls.PlayerControlsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="PlayerSurface"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    AutomationProperties.Name="Video player"
    PointerMoved="UserControl_PointerMoved"
    PointerExited="UserControl_PointerExited">

    <!--
        The pointer surface is the transparent root: a short click shows or
        hides the controls, a 0.4 s press on either half holds that side's
        speed, a mouse double click toggles full screen, and a touch double
        tap skips (left and right thirds) or plays and pauses (center).
        Buttons and sliders handle their own presses, so those never reach it.
    -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerPressed="Surface_PointerPressed"
        PointerReleased="Surface_PointerReleased"
        PointerCanceled="Surface_PointerCanceled"
        PointerCaptureLost="Surface_PointerCanceled"
        DoubleTapped="Surface_DoubleTapped"
        PointerWheelChanged="Surface_PointerWheelChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ControlVisibilityStates">
                <VisualState x:Name="ControlsVisible">
                    <VisualState.Setters>
                        <Setter Target="OverlayContainer.Opacity" Value="1"/>
                        <Setter Target="OverlayContainer.IsHitTestVisible" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ControlsHidden">
                    <VisualState.Setters>
                        <Setter Target="OverlayContainer.Opacity" Value="0"/>
                        <Setter Target="OverlayContainer.IsHitTestVisible" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="OverlayContainer" Background="#44000000">
            <!-- Top Bar -->
            <Grid VerticalAlignment="Top" Padding="24,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button x:Uid="PlayerBackButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="BackButton_Click" Padding="10" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/chevron-left.svg" Width="18" Height="18" />
                    </Button>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" Foreground="{StaticResource EdendaleTextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource BodySMTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                    <Button x:Uid="PlayerAdjustmentsButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="AdjustmentsButton_Click" Padding="10" ToolTipService.ToolTip="Player Adjustments" AutomationProperties.Name="Player Adjustments">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/sliders.svg" Width="18" Height="18" />
                    </Button>
                    <Button x:Uid="PlayerPlaylistButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="SidebarButton_Click" Padding="10" ToolTipService.ToolTip="Playlist" AutomationProperties.Name="Playlist">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/sidebar-right.svg" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Play/Pause -->
            <Button x:Name="CenterPlayPauseButton" Style="{StaticResource ArchiveGhostButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PlayPauseButton_Click" Padding="32">
                <controls:SvgIcon x:Name="CenterPlayPauseIcon" UriSource="ms-appx:///Assets/Icons/pause.svg" Width="64" Height="64" />
            </Button>

            <!-- Bottom Bar -->
            <Grid VerticalAlignment="Bottom" Padding="24,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="0:00" Style="{StaticResource BodySMTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="45" TextAlignment="Right" />
                    <Slider x:Uid="PlayerTimeline" x:Name="TimelineSlider" Grid.Column="1" VerticalAlignment="Center" ValueChanged="TimelineSlider_ValueChanged" AutomationProperties.Name="Timeline"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Style="{StaticResource BodySMTextStyle}" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="45" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                    <!-- The skip glyphs, tooltips, and names follow Settings → App Controls. -->
                    <Button x:Name="SkipBackButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="SkipBack_Click">
                        <controls:SvgIcon x:Name="SkipBackIcon" UriSource="ms-appx:///Assets/Icons/arrow-rotate-left-10.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="BottomPlayPauseButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="PlayPauseButton_Click">
                        <controls:SvgIcon x:Name="BottomPlayPauseIcon" UriSource="ms-appx:///Assets/Icons/pause.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="SkipForwardButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="SkipForward_Click">
                        <controls:SvgIcon x:Name="SkipForwardIcon" UriSource="ms-appx:///Assets/Icons/arrow-rotate-right-10.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="MuteButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="MuteButton_Click" Margin="8,0,0,0">
                        <controls:SvgIcon x:Name="MuteIcon" UriSource="ms-appx:///Assets/Icons/volume-high.svg" Width="20" Height="20" />
                    </Button>
                    <Slider
                        x:Uid="PlayerVolumeSlider"
                        x:Name="VolumeSlider"
                        Width="110"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        LargeChange="10"
                        Value="100"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="SubtitlesButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="SubtitlesButton_Click" x:Uid="SubtitlesButton" ToolTipService.ToolTip="Subtitles" AutomationProperties.Name="Subtitles">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/subtitles.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="AudioOutputButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="AudioOutputButton_Click" x:Uid="AudioOutputButton" ToolTipService.ToolTip="Audio Output" AutomationProperties.Name="Audio Output">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/speaker.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="PictureInPictureButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="PictureInPictureButton_Click">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/picture-in-picture.svg" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="FullScreenButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="FullScreenButton_Click">
                        <controls:SvgIcon x:Name="FullScreenIcon" UriSource="ms-appx:///Assets/Icons/expand.svg" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- F.5: a pill near the top for volume, mute, brightness, speed while
             holding, and skips. It never takes input; screen readers hear the
             same text through the live region. -->
        <Border
            x:Name="HudPill"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,72,0,0"
            Padding="18,8"
            CornerRadius="18"
            Opacity="0"
            Background="{StaticResource EdendaleSurfaceLowBrush}"
            BorderBrush="{StaticResource EdendaleHairlineBorderBrush}"
            BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:SvgIcon x:Name="HudIcon" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource EdendaleGoldBrush}" />
                <TextBlock
                    x:Name="HudText"
                    Style="{StaticResource BodySMTextStyle}"
                    Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>

        <!-- 3.4: Up Next, during the last 30 s of an episode with a stored
             successor. A sibling of the controls, so it stays while they hide. -->
        <Button
            x:Name="UpNextCard"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,96,24,0"
            Style="{StaticResource CardButtonStyle}"
            Click="UpNextCard_Click">
            <Border
                Width="300"
                CornerRadius="8"
                Background="{StaticResource EdendaleSurfaceBrush}"
                BorderBrush="{StaticResource EdendaleHairlineBorderBrush}"
                BorderThickness="1">
                <StackPanel>
                    <Grid Height="169" Background="{StaticResource EdendaleSurfaceHighBrush}" CornerRadius="8,8,0,0">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/tv.svg" Width="40" Height="40" Foreground="{StaticResource EdendaleOutlineBrush}" />
                        <Image x:Name="UpNextImage" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Padding="14,10,14,12" Spacing="2">
                        <TextBlock x:Uid="UpNextLabel" Text="UP NEXT" Style="{StaticResource LabelCapsTextStyle}" Foreground="{StaticResource EdendaleGoldBrush}" />
                        <TextBlock x:Name="UpNextCode" Style="{StaticResource BodySMTextStyle}" />
                        <TextBlock
                            x:Name="UpNextTitle"
                            Style="{StaticResource BodyLGTextStyle}"
                            Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Button>

        <!-- 3.5: Skip Intro / Recap / Credits, bottom trailing, even while the
             controls are hidden. Never skips on its own; S presses it. -->
        <Button
            x:Name="SkipSegmentButton"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,148"
            Padding="20,12"
            Style="{StaticResource ArchivePrimaryButtonStyle}"
            Click="SkipSegmentButton_Click" />

        <!-- Online subtitle browser. A sibling of OverlayContainer rather than
             a child, so the auto-hide that fades the controls never takes the
             open panel with it. -->
        <Border x:Name="SubtitleBrowser"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,80,0,104"
                Width="460"
                MaxHeight="560"
                CornerRadius="16"
                Background="{StaticResource EdendaleSurfaceLowBrush}"
                BorderBrush="{StaticResource EdendaleHairlineBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource EdendaleHairlineBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock x:Uid="SubtitleBrowserHeader"
                               Style="{StaticResource LabelCapsTextStyle}"
                               Text="ONLINE SUBTITLES"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ArchiveGhostButtonStyle}"
                            x:Uid="SubtitleBrowserCloseButton"
                            ToolTipService.ToolTip="Close"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="8"
                            Click="SubtitleBrowserClose_Click">
                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/xmark.svg" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <!-- What is being searched for -->
                <TextBlock x:Name="SubtitleBrowserSubject"
                           Grid.Row="1"
                           Margin="20,12,20,0"
                           Style="{StaticResource BodySMTextStyle}"
                           Foreground="{StaticResource EdendaleTextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Language filter -->
                <Grid Grid.Row="2" Margin="20,12,20,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SubtitleLanguageBox"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="SubtitleLanguageBox_SelectionChanged"/>
                    <Button x:Name="SubtitleRefreshButton"
                            x:Uid="SubtitleRefreshButton"
                            Grid.Column="1"
                            Style="{StaticResource ArchiveSecondaryButtonStyle}"
                            Content="Search"
                            Click="SubtitleRefresh_Click"/>
                </Grid>

                <!-- Results, or the state that replaces them -->
                <Grid Grid.Row="3" MinHeight="120">
                    <ScrollViewer x:Name="SubtitleResultsScroller" Padding="20,0,20,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SubtitleResultsPanel" Spacing="6"/>
                    </ScrollViewer>

                    <StackPanel x:Name="SubtitleStatePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24,8"
                                Spacing="12">
                        <ProgressRing x:Name="SubtitleProgressRing"
                                      Width="28"
                                      Height="28"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource EdendaleGoldBrush}"/>
                        <TextBlock x:Name="SubtitleStateText"
                                   Style="{StaticResource BodySMTextStyle}"
                                   Foreground="{StaticResource EdendaleTextSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
