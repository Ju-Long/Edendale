<UserControl
    x:Class="Edendale.Windows.Controls.AudioEnhancementSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls">

    <!-- AUDIO ENHANCEMENT (AudioEnhancementSection.swift): five equalizer
         profiles as chips, with the preamp and ten bands behind a toggle.
         Changes reach the playing file at once. -->
    <StackPanel>
        <TextBlock x:Uid="SettingsAudioEnhancementHeader" Text="AUDIO ENHANCEMENT" Style="{StaticResource SettingsSectionHeaderTextStyle}" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
            <StackPanel>
                <StackPanel Padding="20,16" Spacing="12">
                    <Grid>
                        <TextBlock x:Uid="SettingsAudioProfileLabel" Text="Profile" Style="{StaticResource SettingsRowLabelTextStyle}" Foreground="{StaticResource EdendaleTextPrimaryBrush}" />
                        <ToggleButton
                            x:Name="EqualizerToggle"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ArchiveChipStyle}"
                            Padding="10,6"
                            Click="EqualizerToggle_Click">
                            <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/sliders.svg" Width="16" Height="16" />
                        </ToggleButton>
                    </Grid>
                    <VariableSizedWrapGrid x:Name="ProfileChips" Orientation="Horizontal" ItemWidth="132" ItemHeight="40" />
                </StackPanel>

                <!-- The equalizer: preamp, then ten bands in two columns. The
                     sliders move the reader's adjustment; the gold value is
                     what plays (profile plus adjustment). -->
                <Border x:Name="EqualizerPanel" Style="{StaticResource SettingsConditionalRowBorderStyle}" Visibility="Collapsed">
                    <StackPanel Padding="20,16" Spacing="14">
                        <StackPanel x:Name="PreampRow" />
                        <Grid x:Name="BandGrid" ColumnSpacing="32" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ResetRow" Style="{StaticResource SettingsConditionalRowBorderStyle}" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource SettingsActionRowPanelStyle}">
                        <Button
                            x:Uid="SettingsAudioResetButton"
                            Style="{StaticResource ArchiveGhostButtonStyle}"
                            Content="RESET EQUALIZER"
                            Click="Reset_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                <TextBlock
                    x:Uid="SettingsAudioEnhancementDescription"
                    Text="Applies to every file. Night Mode evens out the balance between dialogue and effects; it does not compress. Audio Booster in the player adds 10 dB."
                    Style="{StaticResource SettingsBodyRowTextStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
