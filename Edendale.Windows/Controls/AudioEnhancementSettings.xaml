<UserControl
    x:Class="Edendale.Windows.Controls.AudioEnhancementSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls">

    <!-- AUDIO ENHANCEMENT (AudioEnhancementSection.swift), Settings → Audio:
         five equalizer profiles as chips, then, always shown, the ten bands
         as a graph whose centre line is 0 dB and the preamp. Both show
         absolute levels: a profile sets them, the user moves them from there,
         and choosing another profile starts again from its curve. The
         player's Audio Booster adds its gain on top without moving the
         preamp. Changes reach the playing file at once. -->
    <StackPanel>
        <TextBlock x:Uid="SettingsAudioEnhancementHeader" Text="AUDIO ENHANCEMENT" Style="{StaticResource SettingsSectionHeaderTextStyle}" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
            <StackPanel>
                <StackPanel Padding="20,16" Spacing="12">
                    <TextBlock x:Uid="SettingsAudioProfileLabel" Text="Profile" Style="{StaticResource SettingsRowLabelTextStyle}" Foreground="{StaticResource EdendaleTextPrimaryBrush}" />
                    <VariableSizedWrapGrid x:Name="ProfileChips" Orientation="Horizontal" ItemWidth="132" ItemHeight="40" />
                </StackPanel>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                <StackPanel Padding="20,16" Spacing="18">
                    <controls:EqualizerGraph x:Name="Graph" />

                    <!-- The preamp before the booster, in whole decibels. -->
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock x:Name="PreampLabel" Style="{StaticResource BodySMTextStyle}" />
                            <TextBlock
                                x:Name="PreampValue"
                                Style="{StaticResource BodySMTextStyle}"
                                Foreground="{StaticResource EdendaleGoldBrush}"
                                HorizontalAlignment="Right" />
                        </Grid>
                        <controls:DecibelSlider
                            x:Name="PreampSlider"
                            Minimum="-20"
                            Maximum="20"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="3"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="PreampSlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="ResetRow" Style="{StaticResource SettingsConditionalRowBorderStyle}" Visibility="Collapsed">
                    <controls:WrapPanel Style="{StaticResource SettingsActionRowPanelStyle}">
                        <Button
                            x:Uid="SettingsAudioResetButton"
                            Style="{StaticResource ArchiveGhostButtonStyle}"
                            Content="RESET EQUALIZER"
                            Click="Reset_Click" />
                    </controls:WrapPanel>
                </Border>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}" />

                <TextBlock
                    x:Uid="SettingsAudioEnhancementDescription"
                    Text="Applies to every file. Night Mode evens out the balance between dialogue and effects; it does not compress. Audio Booster in the player adds 10 dB."
                    Style="{StaticResource SettingsBodyRowTextStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
