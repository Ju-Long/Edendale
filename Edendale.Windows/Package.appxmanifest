<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX identity for packaged builds. Visual Studio always sees this manifest
  so its Package and Publish commands are available; the unpackaged launch
  profile still starts the executable without registering a package.

  Publisher must match the signing certificate's subject exactly, byte for
  byte, or installation fails with a certificate mismatch. The checked-in
  version mirrors Directory.Build.props for local Store packaging; tagged
  releases stamp it again from the tag.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap rescap mp desktop2">

  <Identity
    Name="LongJu.Edendale"
    Publisher="CN=C4738BFE-2E22-4A2E-B398-D004D760ABE2"
    Version="27.1.0.0" />

  <!-- Edendale has no Windows Phone predecessor. The Store schema still
       requires PhonePublisherId whenever association adds PhoneIdentity. -->
  <mp:PhoneIdentity
    PhoneProductId="04939c38-d94a-415f-a943-d6dbe1977f97"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Edendale</DisplayName>
    <PublisherDisplayName>Long Ju</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- Declared so the package advertises the locales the app actually ships;
       these mirror the Strings/<lang>/Resources.resw folders. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="en-AU" />
    <Resource Language="en-CA" />
    <Resource Language="en-GB" />
    <Resource Language="de" />
    <Resource Language="es-ES" />
    <Resource Language="es-MX" />
    <Resource Language="fr" />
    <Resource Language="it" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="nl" />
    <Resource Language="pt-BR" />
    <Resource Language="pt-PT" />
    <Resource Language="ru" />
    <Resource Language="sv" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Edendale.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Edendale"
        Description="Free, open-source video player and personal watch tracker."
        BackgroundColor="#0A0A0F"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0A0A0F" />
      </uap:VisualElements>
      <Extensions>
        <!-- edendale:// links (AppRoute): jump-list entries, links to a title,
             and the pairing QR code Windows Camera opens (SYNC-PROTOCOL.md
             §9.3). A packaged app can only declare its protocol here; the
             runtime registration in ActivationService serves unpackaged builds. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="edendale">
            <uap:DisplayName>Edendale</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Packaged Win32 desktop apps require full trust to run at all. -->
    <rescap:Capability Name="runFullTrust" />
    <!--
      The library stores plain filesystem paths and re-reads them on later
      launches through Win32 APIs (LibraryService, MediaSource.CreateFromUri).
      Without this the picker grant lasts one session and the library breaks on
      second launch. This is a restricted capability: Microsoft Store
      submission requires written justification and often refuses it, which is
      why Edendale ships as a sideloaded MSIX.
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <!-- TMDB metadata, Wyzie subtitles, and trailer playback. -->
    <Capability Name="internetClient" />
    <!-- SMB shares on the user's own network. -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

  <Extensions>
    <!-- The pairing screen listens for the other device on a TCP port the
         system picks (Set Up / Receive from Another Device, SYNC-PROTOCOL.md
         §9). A full-trust app gets no capability-based firewall rule, so
         without these Windows prompts the first time, and a dismissed prompt
         leaves the other device unable to connect: the Windows counterpart
         of the Mac's incoming-connections entitlement (apple-27.1 K.7).
         Public networks stay closed. -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Edendale.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="private" />
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="domain" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
