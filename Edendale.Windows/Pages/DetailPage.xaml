<Page
    x:Class="Edendale.Windows.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    Background="{StaticResource EdendaleBackgroundBrush}">

    <Grid>
        <ScrollViewer>
        <StackPanel Spacing="40" Padding="0,0,0,64">

            <!-- Cinematic hero: backdrop + scrim, gold tagline kicker, Bebas
                 display title, genre tag, meta row, actions. -->
            <Grid MinHeight="480">
                <Image x:Name="HeroBackdrop" Stretch="UniformToFill" MaxHeight="560" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#000A0A0F" Offset="0.35" />
                            <GradientStop Color="{StaticResource EdendaleBackgroundColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel
                    x:Name="HeroTextStack"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="48"
                    Spacing="16"
                    MaxWidth="960">
                    <TextBlock
                        x:Name="TaglineText"
                        Style="{StaticResource LabelCapsTextStyle}"
                        Foreground="{StaticResource EdendaleGoldBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="{StaticResource DisplayFontFamily}"
                        FontSize="80"
                        Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="GenreTag"
                        BorderBrush="{StaticResource EdendaleOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <TextBlock x:Name="GenreTagText" Style="{StaticResource LabelCapsTextStyle}" />
                    </Border>
                    <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="12" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                        <Button x:Name="PlayButton" Style="{StaticResource ArchivePrimaryButtonStyle}" Click="Play_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/play.svg" Width="12" Height="12" Foreground="{Binding Foreground, ElementName=PlayLabel}" />
                                <TextBlock x:Uid="DetailPlayLabel" x:Name="PlayLabel" Text="PLAY" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WatchedButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="ToggleWatched_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon x:Name="WatchedIcon" UriSource="ms-appx:///Assets/Icons/eye.svg" Width="12" Height="12" Foreground="{Binding Foreground, ElementName=WatchedLabel}" />
                                <TextBlock x:Uid="DetailWatchedLabel" x:Name="WatchedLabel" Text="MARK WATCHED" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TrailerButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="Trailer_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/film.svg" Width="12" Height="12" Foreground="{Binding Foreground, ElementName=TrailerLabel}" />
                                <TextBlock x:Uid="DetailTrailerLabel" x:Name="TrailerLabel" Text="WATCH TRAILER" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Favourite / watchlist / rating — stored locally, synced
                         to OneDrive and (when connected) the TMDB account. -->
                    <StackPanel x:Name="UserMediaRow" Orientation="Horizontal" Spacing="14" Visibility="Collapsed">
                        <Button x:Name="FavouriteButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="ToggleFavourite_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon x:Name="FavouriteIcon" UriSource="ms-appx:///Assets/Icons/heart.svg" Width="12" Height="12" Foreground="{Binding Foreground, ElementName=FavouriteLabel}" />
                                <TextBlock x:Uid="DetailFavouriteLabel" x:Name="FavouriteLabel" Text="FAVOURITE" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WatchlistButton" Style="{StaticResource ArchiveGhostButtonStyle}" Click="ToggleWatchlist_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon x:Name="WatchlistIcon" UriSource="ms-appx:///Assets/Icons/bookmark-plus.svg" Width="12" Height="12" Foreground="{Binding Foreground, ElementName=WatchlistLabel}" />
                                <TextBlock x:Uid="DetailWatchlistLabel" x:Name="WatchlistLabel" Text="WATCHLIST" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <RatingControl
                                x:Name="RatingInput"
                                MaxRating="5"
                                IsClearEnabled="True"
                                ValueChanged="Rating_ValueChanged"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="RatingLabel"
                                Style="{StaticResource BodySMTextStyle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Two-column body: archive record + cast | consensus rail. -->
            <Grid Margin="48,0" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="40">
                    <Border x:Name="ArchiveRecordCard" Style="{StaticResource GlassCardBorderStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <TextBlock x:Uid="DetailArchiveRecordHeader" Text="THE ARCHIVE RECORD" Style="{StaticResource HeadlineMDTextStyle}" />
                            <TextBlock
                                x:Name="OverviewText"
                                Style="{StaticResource BodyLGTextStyle}"
                                TextWrapping="Wrap"
                                MaxLines="6"
                                TextTrimming="CharacterEllipsis"
                                IsTextTrimmedChanged="Overview_IsTextTrimmedChanged" />
                            <!-- Only appears when the overview actually clips (ExpandableText.swift). -->
                            <Button
                                x:Name="OverviewToggle"
                                Style="{StaticResource CardButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="6,4"
                                Visibility="Collapsed"
                                Click="OverviewToggle_Click">
                                <controls:SvgIcon
                                    x:Name="OverviewToggleIcon"
                                    UriSource="ms-appx:///Assets/Icons/chevron-down.svg"
                                    Width="14" Height="14"

                                    Foreground="{StaticResource EdendaleGoldBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="CastSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Uid="DetailPrincipalCastHeader" Text="PRINCIPAL CAST" Style="{StaticResource LabelCapsTextStyle}" Foreground="{StaticResource EdendaleGoldBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="CastList" Orientation="Horizontal" Spacing="18" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" x:Name="ConsensusSection" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Uid="DetailCriticalConsensusHeader" Text="CRITICAL CONSENSUS" Style="{StaticResource LabelCapsTextStyle}" Foreground="{StaticResource EdendaleGoldBrush}" />
                    <Border Style="{StaticResource GlassCardBorderStyle}" Padding="20">
                        <StackPanel x:Name="ScoreTiles" Spacing="20" />
                    </Border>
                    <Grid x:Name="TaglineQuote" ColumnSpacing="14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource EdendaleGoldDeepBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            x:Name="TaglineQuoteText"
                            FontFamily="{StaticResource TextItalicFontFamily}"
                            FontStyle="Italic"
                            FontSize="16"
                            Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Local show episodes, grouped by season. -->
            <StackPanel x:Name="EpisodesSection" Spacing="18" Margin="48,0" Visibility="Collapsed">
                <controls:SectionHeader TitleKey="Section_Episodes" />
                <StackPanel x:Name="SeasonsList" Spacing="12" />
            </StackPanel>

            <!-- TMDB season browser: shown instead of the list above when the
                 show has no imported copy. Seasons arrive with the detail
                 response; each episode list is fetched on demand. -->
            <StackPanel x:Name="TmdbSeasonsSection" Spacing="14" Margin="48,0" Visibility="Collapsed">
                <controls:SectionHeader TitleKey="Section_Episodes" />
                <ScrollViewer
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="SeasonChips" Orientation="Horizontal" Spacing="10" />
                </ScrollViewer>
                <ProgressRing x:Name="SeasonProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                <TextBlock
                    x:Name="SeasonMessage"
                    Visibility="Collapsed"
                    Style="{StaticResource BodySMTextStyle}"
                    Foreground="{StaticResource EdendaleTextSecondaryBrush}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    x:Name="TmdbEpisodeScroller"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    Padding="0,0,0,14">
                    <StackPanel x:Name="TmdbEpisodeShelf" Orientation="Horizontal" Spacing="20" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- The one back affordance in the app: detail pages are the only
             pushed navigation, so the arrow lives here, not the sidebar. -->
        <Button
            x:Name="BackButton"
            Style="{StaticResource ArchiveGhostButtonStyle}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,20,0,0"
            Padding="12"
            Background="#66131318"
            CornerRadius="20"
            Click="Back_Click"
            x:Uid="DetailBackButton"
            AutomationProperties.Name="Back">
            <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/chevron-left.svg" Width="16" Height="16" Foreground="{StaticResource EdendaleTextPrimaryBrush}" />
        </Button>
    </Grid>
</Page>
