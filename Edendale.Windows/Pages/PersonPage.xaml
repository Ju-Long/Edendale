<Page
    x:Class="Edendale.Windows.Pages.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    xmlns:helpers="using:Edendale.Windows.Helpers"
    xmlns:models="using:Edendale.Windows.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource EdendaleBackgroundBrush}">

    <Page.Resources>
        <!-- Tag carries the item: ItemsRepeater does not set DataContext on
             x:Bind templates, so Click handlers read Tag instead. -->
        <DataTemplate x:Key="FilmographyTemplate" x:DataType="models:MediaItem">
            <Button Style="{StaticResource CardButtonStyle}" Click="Credit_Click" Tag="{x:Bind}">
                <controls:PosterCard
                    Title="{x:Bind Title}"
                    Subtitle="{x:Bind helpers:Format.YearText(Year)}"
                    ImageUrl="{x:Bind PosterUrl}"
                    CardWidth="180"
                    PlaceholderAsset="{x:Bind helpers:Format.MediaAsset(MediaType)}" />
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Style="{StaticResource ArchiveGhostButtonStyle}"
            Margin="48,24,48,0"
            HorizontalAlignment="Left"
            Click="Back_Click"
            x:Uid="PersonBackButton"
            AutomationProperties.Name="Back">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/chevron-left.svg" Width="14" Height="14" />
                <TextBlock x:Uid="PersonBackLabel" Text="BACK" Style="{StaticResource LabelCapsTextStyle}" />
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="40" Padding="48,20,48,64">

                <!-- Portrait left, biography right. VisualStateManager stacks
                     them when the window is too narrow for two columns. -->
                <Grid ColumnSpacing="28" RowSpacing="20">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="820" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="PortraitBorder.(Grid.Row)" Value="0" />
                                    <Setter Target="PortraitBorder.(Grid.Column)" Value="0" />
                                    <Setter Target="BiographyPanel.(Grid.Row)" Value="0" />
                                    <Setter Target="BiographyPanel.(Grid.Column)" Value="1" />
                                    <Setter Target="PortraitBorder.Width" Value="220" />
                                    <Setter Target="PortraitBorder.Height" Value="330" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="NarrowHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="PortraitBorder.(Grid.Row)" Value="0" />
                                    <Setter Target="PortraitBorder.(Grid.Column)" Value="0" />
                                    <Setter Target="BiographyPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="BiographyPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="PortraitBorder.Width" Value="170" />
                                    <Setter Target="PortraitBorder.Height" Value="255" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="PortraitBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="220"
                        Height="330"
                        VerticalAlignment="Top"
                        CornerRadius="12"
                        Background="{StaticResource EdendaleSurfaceBrush}"
                        BorderBrush="{StaticResource EdendaleHairlineBorderBrush}"
                        BorderThickness="1">
                        <Grid>
                            <controls:SvgIcon
                                UriSource="ms-appx:///Assets/Icons/circle-user-fill.svg"
                                Width="72" Height="72"
                                Foreground="{StaticResource EdendaleSurfaceHighBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Image x:Name="PortraitImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel
                        x:Name="BiographyPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="14"
                        VerticalAlignment="Top">
                        <TextBlock
                            x:Name="DepartmentText"
                            Style="{StaticResource LabelCapsTextStyle}"
                            Foreground="{StaticResource EdendaleGoldBrush}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="NameText"
                            Style="{StaticResource HeadlineMDTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="VitalsText"
                            Style="{StaticResource BodySMTextStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="BiographyText"
                            Style="{StaticResource BodyLGTextStyle}"
                            TextWrapping="Wrap"
                            MaxLines="8"
                            TextTrimming="CharacterEllipsis"
                            IsTextTrimmedChanged="Biography_IsTextTrimmedChanged" />
                        <!-- Only appears when the biography actually clips. -->
                        <Button
                            x:Name="BiographyToggle"
                            Style="{StaticResource CardButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="6,4"
                            Visibility="Collapsed"
                            Click="BiographyToggle_Click">
                            <controls:SvgIcon
                                x:Name="BiographyToggleIcon"
                                UriSource="ms-appx:///Assets/Icons/chevron-down.svg"
                                Width="14" Height="14"
                                Foreground="{StaticResource EdendaleGoldBrush}" />
                        </Button>

                        <!-- Bridge to the existing "Starring …" search filter. -->
                        <Button
                            x:Name="ShowInSearchButton"
                            Style="{StaticResource ArchiveGhostButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="ShowInSearch_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/magnifying-glass-play.svg" Width="14" Height="14" />
                                <TextBlock x:Uid="ShowInSearchLabel" Text="SHOW IN SEARCH" Style="{StaticResource LabelCapsTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="FilmographySection" Spacing="18" Visibility="Collapsed">
                    <controls:SectionHeader TitleKey="Section_Filmography" />
                    <muxc:ItemsRepeater x:Name="FilmographyRepeater" ItemTemplate="{StaticResource FilmographyTemplate}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout MinItemWidth="180" MinRowSpacing="20" MinColumnSpacing="20" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </StackPanel>

                <TextBlock
                    x:Name="StatusMessage"
                    Style="{StaticResource BodySMTextStyle}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            IsActive="False"
            Width="28"
            Height="28"
            Foreground="{StaticResource EdendaleGoldBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0" />
    </Grid>
</Page>
