<Page
    x:Class="Edendale.Windows.Pages.MoviesShowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Edendale.Windows.Controls"
    xmlns:models="using:Edendale.Windows.Models"
    xmlns:helpers="using:Edendale.Windows.Helpers"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource EdendaleBackgroundBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Tag carries the item: ItemsRepeater does not set DataContext on
             x:Bind templates, so Click handlers read Tag instead. -->
        <DataTemplate x:Key="ShelfPosterTemplate" x:DataType="models:MediaItem">
            <Button Style="{StaticResource CardButtonStyle}" Click="ShelfItem_Click" Tag="{x:Bind}">
                <controls:PosterCard
                    Title="{x:Bind Title}"
                    Subtitle="{x:Bind helpers:Format.YearText(Year)}"
                    ImageUrl="{x:Bind PosterUrl}"
                    CardWidth="180"
                    PlaceholderAsset="ms-appx:///Assets/Icons/film.svg" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CollectionCardTemplate" x:DataType="models:MediaItem">
            <Button Style="{StaticResource CardButtonStyle}" Click="ShelfItem_Click" Tag="{x:Bind}">
                <controls:LandscapeCard
                    Title="{x:Bind Title}"
                    Subtitle="{x:Bind helpers:Format.YearText(Year)}"
                    ImageUrl="{x:Bind BackdropUrl}"
                    CardWidth="320"
                    CaptionInside="True"
                    PlaceholderAsset="ms-appx:///Assets/Icons/film.svg" />
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <StackPanel
            x:Name="LoadingState"
            Spacing="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="36" Height="36" Foreground="{StaticResource EdendaleGoldBrush}" />
            <TextBlock Text="LOADING THE ARCHIVE" Style="{StaticResource LabelCapsTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Missing TMDB key -->
        <StackPanel
            x:Name="MissingKeyState"
            Spacing="18"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/film.svg" Width="44" Height="44" Foreground="{StaticResource EdendaleSurfaceHighBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="THE PROJECTOR IS DARK" Style="{StaticResource HeadlineMDTextStyle}" HorizontalAlignment="Center" />
            <TextBlock
                x:Name="MissingKeyMessage"
                Text="Run init.ps1 in the repository root to add TMDB credentials, rebuild Edendale, and the archive lights up."
                Style="{StaticResource BodyLGTextStyle}"
                TextAlignment="Center" />
        </StackPanel>

        <!-- Error -->
        <StackPanel
            x:Name="ErrorState"
            Spacing="18"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock Text="THE REEL SNAPPED" Style="{StaticResource HeadlineMDTextStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorMessageText" Style="{StaticResource BodySMTextStyle}" TextAlignment="Center" />
            <Button
                Content="TRY AGAIN"
                Style="{StaticResource ArchiveSecondaryButtonStyle}"
                HorizontalAlignment="Center"
                Click="Retry_Click" />
        </StackPanel>

        <!-- Loaded -->
        <ScrollViewer x:Name="ContentScroll" Visibility="Collapsed">
            <StackPanel Spacing="48" Padding="0,0,0,64">

                <!-- Hero pager: backdrop + scrims + kicker + display title +
                     meta + actions; auto-advances every 10s, paused on hover. -->
                <StackPanel Spacing="16">
                    <Grid
                        x:Name="HeroSurface"
                        Height="520"
                        PointerEntered="Hero_PointerEntered"
                        PointerExited="Hero_PointerExited">
                        <Image x:Name="HeroBackdrop" Stretch="UniformToFill" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#000A0A0F" Offset="0.35" />
                                    <GradientStop Color="{StaticResource EdendaleBackgroundColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#B30A0A0F" Offset="0" />
                                    <GradientStop Color="#000A0A0F" Offset="0.6" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel
                            x:Name="HeroTextStack"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="48"
                            Spacing="18"
                            MaxWidth="900">
                            <StackPanel x:Name="ContinueRow" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                                <Border BorderBrush="{StaticResource EdendaleGoldDeepBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                    <TextBlock Text="CONTINUE WATCHING" Style="{StaticResource LabelCapsTextStyle}" Foreground="{StaticResource EdendaleGoldBrush}" />
                                </Border>
                                <TextBlock x:Name="RemainingText" Style="{StaticResource LabelCapsTextStyle}" Foreground="{StaticResource EdendaleGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock
                                x:Name="HeroTitleText"
                                FontFamily="{StaticResource DisplayFontFamily}"
                                FontSize="88"
                                Foreground="{StaticResource EdendaleTextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                TextWrapping="Wrap" />

                            <StackPanel x:Name="HeroMetaRow" Orientation="Horizontal" Spacing="14" />

                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                                <Button x:Name="HeroPlayButton" Style="{StaticResource ArchivePrimaryButtonStyle}" Click="HeroPlay_Click" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/play.svg" Width="12" Height="12" />
                                        <TextBlock x:Name="HeroPlayLabel" Text="PLAY" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeroDetailsButton" Style="{StaticResource ArchiveSecondaryButtonStyle}" Click="HeroDetails_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/circle-info.svg" Width="12" Height="12" />
                                        <TextBlock Text="DETAILS" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeroTrailerButton" Style="{StaticResource ArchiveSecondaryButtonStyle}" Click="HeroTrailer_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:SvgIcon UriSource="ms-appx:///Assets/Icons/film.svg" Width="12" Height="12" />
                                        <TextBlock x:Name="HeroTrailerLabel" Text="WATCH TRAILER" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        x:Name="HeroDots"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="48,0" />
                </StackPanel>

                <!-- Shelves -->
                <StackPanel x:Name="TrendingShelf" Spacing="18" Visibility="Collapsed">
                    <controls:SectionHeader Title="Trending Today" Margin="48,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater x:Name="TrendingRepeater" Margin="48,14" ItemTemplate="{StaticResource ShelfPosterTemplate}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="20" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="PopularMoviesShelf" Spacing="18" Visibility="Collapsed">
                    <controls:SectionHeader Title="Popular Films" Margin="48,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater x:Name="PopularMoviesRepeater" Margin="48,14" ItemTemplate="{StaticResource ShelfPosterTemplate}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="20" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="PopularShowsShelf" Spacing="18" Visibility="Collapsed">
                    <controls:SectionHeader Title="Popular Series" Margin="48,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater x:Name="PopularShowsRepeater" Margin="48,14" ItemTemplate="{StaticResource ShelfPosterTemplate}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="20" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="TopRatedShelf" Spacing="18" Visibility="Collapsed">
                    <controls:SectionHeader Title="Top Rated" Margin="48,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <muxc:ItemsRepeater x:Name="TopRatedRepeater" Margin="48,14" ItemTemplate="{StaticResource ShelfPosterTemplate}">
                            <muxc:ItemsRepeater.Layout>
                                <muxc:StackLayout Orientation="Horizontal" Spacing="20" />
                            </muxc:ItemsRepeater.Layout>
                        </muxc:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Curated collections -->
                <StackPanel Spacing="18">
                    <controls:SectionHeader Title="Curated Collections" Margin="48,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="CollectionChips" Orientation="Horizontal" Spacing="10" Margin="48,0" />
                    </ScrollViewer>
                    <muxc:ItemsRepeater x:Name="CollectionRepeater" Margin="48,0" ItemTemplate="{StaticResource CollectionCardTemplate}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout MinItemWidth="320" MinItemHeight="180" MinRowSpacing="20" MinColumnSpacing="20" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
